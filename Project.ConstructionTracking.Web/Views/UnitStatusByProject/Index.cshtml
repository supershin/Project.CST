@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutSite.cshtml";
    var ListProject = ViewBag.ListProject;
    var ddlListUnitStatus = ViewBag.DDLList;
}
@model List<Project.ConstructionTracking.Web.Models.StoreProcedureModel.UnitStatusModel>


<div class="page-wrapper">
    <div class="page-header d-print-none">
        <div class="card bg-primary text-primary-fg">
            <div class="card-stamp">
                <div class="card-stamp-icon bg-white text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-home-heart">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M21 12l-9 -9l-9 9h2v7a2 2 0 0 0 2 2h6" />
                        <path d="M9 21v-6a2 2 0 0 1 2 -2h2c.39 0 .754 .112 1.061 .304" />
                        <path d="M19 21.5l2.518 -2.58a1.74 1.74 0 0 0 0 -2.413a1.627 1.627 0 0 0 -2.346 0l-.168 .172l-.168 -.172a1.627 1.627 0 0 0 -2.346 0a1.74 1.74 0 0 0 0 2.412l2.51 2.59z" />
                    </svg>
                </div>
            </div>
            <div class="card-body">
                <h1>Unit status แสดงในโครงการ</h1>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="card">
            <div class="card-body border-bottom py-3">          
                <form id="form-search" method="post">
                    <div class="row">
                        <div class="col-6 col-md-3">
                            <div class="mb-3">
                                <label class="form-label"><h3>โครงการ</h3></label>
                                <select class="form-select" name="selectedProject">
                                    @foreach (var item in ListProject)
                                    {
                                        <option value="@item.ValueGuid">@item.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="mb-3">
                                <label class="form-label"><h3>สถานะ QC Sync CRM</h3></label>
                                <select class="form-select" name="selectedQCSyncStatus">
                                    <option value="-1">ทั้งหมด</option>
                                    <option value="1">Sync แล้ว</option>
                                    <option value="2">ยังไม่ได้ Sync</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="mb-3">
                                <label class="form-label"><h3>สถานะขาย</h3></label>
                                <select class="form-select" name="selectedUnitStatus">
                                    <option value="">ทั้งหมด</option>
                                    @foreach (var item in ddlListUnitStatus)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="mb-3">
                                <label class="form-label"><h3>สถานะก่อสร้าง</h3></label>
                                <div class="row g-2">
                                    <div class="col">
                                        <select class="form-select" name="selectedBuildStatus">
                                            <option value="-1">ทั้งหมด</option>
                                            <option value="3">ยังไม่เริ่มก่อสร้าง</option>
                                            <option value="2">อยู่ระหว่างก่อสร้าง</option>
                                            <option value="1">บ้านเสร็จ</option>
                                        </select>
                                    </div>
                                    <div class="col-auto">
                                        <button type="submit" class="btn btn-icon" aria-label="Button">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
                                                <path d="M21 21l-6 -6" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div id="PartialTable">
                <partial name="PartialTable" model="Model" />
            </div>
        </div>

        <div class="modal fade" id="modalSync" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">Sync QC to CRM</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="formSync">
                            <div class="mb-3 px-3 py-2 rounded bg-light border d-flex justify-content-start align-items-center gap-4">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="text-muted small fs-22">โครงการ :</div>
                                    <div class="text-dark fs-22" id="projectName"></div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="text-muted small fs-22">รหัสยูนิต Code :</div>
                                    <div class="text-dark fs-22" id="unitCode"></div>
                                </div>

                                <input type="hidden" name="hd_project_code" id="hd_project_code" />
                                <input type="hidden" name="hd_project_id" id="hd_project_id" />
                                <input type="hidden" name="hd_unit_id" id="hd_unit_id" />
                            </div>
                            <div class="mb-2 row">
                                <div class="col-4">
                                    <label class="form-label">
                                        วันที่นัดตรวจ <span class="text-danger">*</span>
                                    </label>
                                    <input type="date"
                                           class="form-control"
                                           name="txt_contractor_appointment_date"
                                           id="txt_contractor_appointment_date"
                                           required>
                                </div>
                                <div class="col-8">
                                    <label class="form-label">เวลาที่นัดตรวจ <span class="text-danger">*</span></label>
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="text"
                                               class="form-control"
                                               name="txt_contractor_appointment_timeStart"
                                               id="txt_contractor_appointment_timeStart"
                                               required>

                                        <span>-</span>

                                        <input type="text"
                                               class="form-control"
                                               name="txt_contractor_appointment_timeEnd"
                                               id="txt_contractor_appointment_timeEnd">
                                    </div>
                                </div>
                            </div>
                            <div class="mb-2 row">
                                <div class="col-4">
                                    <label class="form-label">วันที่ QC5 <span class="text-danger">*</span></label>
                                    <input type="date"
                                           class="form-control"
                                           name="txt_qc_response_date"
                                           id="txt_qc_response_date"
                                           required>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">ประเภทการ Sync<span class="text-danger">*</span></label>
                                    <select class="form-select" name="ddl_sync_type" id="ddl_sync_type">
                                        <option value="-1">กรุณาเลือก</option>
                                        <option value="41">Sync ปกติ</option>
                                        <option value="42">Sync เพื่อโอนก่อนตรวจ</option>
                                        <option value="43">Sync ตรวจห้องก่อน QC5 Pass</option>
                                    </select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">บันทึกโดย</label>
                                    <input type="text"
                                           class="form-control"
                                           name="txt_submit_by"
                                           id="txt_submit_by"
                                           disabled
                                           >                         
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">รายละเอียด :</label>
                                <textarea class="form-control" 
                                          name="txt_qc_remark"
                                          id="txt_qc_remark"
                                          rows="2">
                                </textarea>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSyncSubmit">บันทึก</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="modalViewSync" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title">
                            QC Sync Detail
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="formSync">
                            <div class="mb-3 px-3 py-2 rounded bg-light border d-flex justify-content-start align-items-center gap-4">
                                <div>
                                    <div class="text-muted small mb-1">โครงการ :</div>
                                    <div class="fw-semibold text-dark fs-22" id="view_projectName"></div>
                                </div>
                                <div>
                                    <div class="text-muted small mb-1">รหัสยูนิต Code :</div>
                                    <div class="fw-semibold text-dark fs-20" id="view_unitCode"></div>
                                </div>
                            </div>
                            <div class="mb-2 row">
                                <div class="col-4">
                                    <label class="form-label">
                                        📅 วันที่นัดตรวจ
                                    </label>
                                    <input type="text"
                                           class="form-control"
                                           name="view_appointmentDate"
                                           id="view_appointmentDate"
                                           disabled>
                                </div>
                                <div class="col-8">
                                    <label class="form-label">⏱️ เวลาที่นัดตรวจ</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="text"
                                               class="form-control"
                                               name="view_timeStart"
                                               id="view_timeStart"
                                               disabled>

                                        <span>-</span>

                                        <input type="text"
                                               class="form-control"
                                               name="view_timeEnd"
                                               id="view_timeEnd"
                                               disabled>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-2 row">
                                <div class="col-4">
                                    <label class="form-label">🧾 วันที่ QC5</label>
                                    <input type="text"
                                           class="form-control"
                                           name="view_qc5Date"
                                           id="view_qc5Date"
                                           disabled>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">
                                        🔄 ประเภทการ Sync
                                    </label>
                                    <select class="form-select" name="view_ddl_sync_type" id="view_ddl_sync_type" disabled>
                                        <option value="41">Sync ปกติ</option>
                                        <option value="42">Sync เพื่อโอนก่อนตรวจ</option>
                                        <option value="43">Sync ตรวจห้องก่อน QC5 Pass</option>
                                    </select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">👤 บันทึกโดย</label>
                                    <input type="text"
                                           class="form-control"
                                           name="view_submit_by"
                                           id="view_submit_by"
                                           disabled>
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">📝 รายละเอียด :</label>
                                <textarea class="form-control"
                                          name="view_remark"
                                          id="view_remark"
                                          rows="2"
                                          disabled>
                                </textarea>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/th.js"></script>

    <script>
        $(document).ready(function () {
            setDatatable();
            $('#form-search').on('submit', function (event) {
                showLoadingScreen();
                event.preventDefault();
                var projectId = $('#form-search select[name="selectedProject"]').val() || "";
                var unitStatus = $('#form-search select[name="selectedUnitStatus"]').val() || "";
                var buildStatus = $('#form-search select[name="selectedBuildStatus"]').val() || "";
                var syncQCStatus = $('#form-search select[name="selectedQCSyncStatus"]').val() || "";

                $.ajax({
                    url: baseUrl + 'UnitStatusByProject/SearchUnitStatusByProject', // Use the base URL dynamically
                    type: 'POST',
                    data: {
                        projectId: projectId,
                        unitStatus: unitStatus,
                        buildStatus: buildStatus,
                        syncQCStatus: syncQCStatus
                    },
                    success: function (response) {
                        $('#PartialTable').html(response);
                        setDatatable();
                        Swal.close();
                    },
                    error: function () {
                        Swal.close();
                        console.error('Error fetching data');
                    }
                });
                return false;
            });

            const desktopNavItem = document.getElementById('nav-Desktop');
            const unitPaymentNavItem = document.getElementById('nav-UnitStatus');

            if (desktopNavItem) {
                desktopNavItem.classList.add('active'); // Make Desktop nav active
            }
            if (unitPaymentNavItem) {
                unitPaymentNavItem.classList.add('active'); // Make UnitStatus nav active
            }

        });

        function setDatatable() {
            var table = $('#tbl_1');

            // ล้าง DataTable เดิมก่อน
            if ($.fn.DataTable.isDataTable(table)) {
                table.DataTable().destroy();
                table.empty(); // เคลียร์ DOM table ด้วย
            }

            table.DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]],
                "language": {
                    "lengthMenu": "Show _MENU_ rows per page",
                    "zeroRecords": "ไม่พบข้อมูล",
                    "info": "Showing page _PAGE_ of _PAGES_",
                    "infoEmpty": "No records available",
                    "infoFiltered": "(filtered from _MAX_ total records)"
                }
            });
        }

        flatpickr("#txt_contractor_appointment_date", {
            dateFormat: "d/m/Y",
            allowInput: true
        });

        flatpickr("#txt_qc_response_date", {
            dateFormat: "d/m/Y",
            allowInput: true
        });

        flatpickr("#txt_contractor_appointment_timeStart", {
            enableTime: true,
            noCalendar: true,
            dateFormat: "H:i",
            time_24hr: true,
            minuteIncrement: 5,
        });

        flatpickr("#txt_contractor_appointment_timeEnd", {
            enableTime: true,
            noCalendar: true,
            dateFormat: "H:i",
            time_24hr: true,
            minuteIncrement: 5,
        });

        $(document).on('click', '.open-sync-modal', function () {
            // ✅ Clear values
            $('#projectName').text('');
            $('#unitCode').text('');

            $('#hd_project_code').val('');
            $('#hd_project_id').val('');
            $('#hd_unit_id').val('');

            $('#txt_contractor_appointment_date').val('');
            $('#txt_contractor_appointment_timeStart').val('');
            $('#txt_contractor_appointment_timeEnd').val('');
            $('#ddl_sync_type').val('-1');
            $('#txt_qc_response_date').val('');
            $('#txt_submit_by').val('');
            $('#txt_qc_remark').val('');

            const unitID = $(this).data('unitid');
            const unitCode = $(this).data('unitcode');
            const project = $(this).data('project');
            const projectID = $(this).data('project_id');
            const project_code = $(this).data('project_code');
            const qc5Date = $(this).data('qc5date');
            $('#hd_project_code').val(project_code);
            $('#hd_project_id').val(projectID);
            $('#projectName').text(project);
            $('#hd_unit_id').val(unitID);
            $('#unitCode').text(unitCode);
            $('#qc5Date').val(qc5Date);
            $('#modalSync').modal('show');
        });

        $(document).on('click', '#btnSyncSubmit', function (e) {
            e.preventDefault();
            showLoadingAlert();

            const data = {
                project_code: $('#hd_project_code').val(),
                project_id: $('#hd_project_id').val(),
                unit_id: $('#hd_unit_id').val(),
                unit_number: $('#unitCode').text(),
                sync_type:$('#ddl_sync_type').val(),
                contractor_appointment_date: $('#txt_contractor_appointment_date').val(),
                contractor_appointment_timeStart: $('#txt_contractor_appointment_timeStart').val(),
                contractor_appointment_timeEnd: $('#txt_contractor_appointment_timeEnd').val(),
                qc_response_date: $('#txt_qc_response_date').val(),
                qc_remark: $('#txt_qc_remark').val().trim()
            };

            // 🔥 1. จำหน้าปัจจุบันก่อน trigger submit
            let savedPage = 0;
            if ($.fn.DataTable.isDataTable('#tbl_1')) {
                savedPage = $('#tbl_1').DataTable().page();
            }

            $.ajax({
                url: baseUrl + 'UnitStatusByProject/SubmitSyncQC5',
                type: 'POST',
                data: data,
                success: function (res) {
                    if (res.Status === 1) {
                        reloadTablePreservePage(savedPage, function () {
                            showSuccessAlert('สำเร็จ!', res.message);
                        });
                    } else {
                        Swal.close();
                        showErrorAlert('ผิดพลาด!', res.message);
                    }
                },
                error: function () {
                    Swal.close();
                    showErrorAlert('ผิดพลาด!', 'เกิดข้อผิดพลาดในการส่งข้อมูล');
                }
            });
        });

        function reloadTablePreservePage(savedPage, callback) {
            var projectId = $('#form-search select[name="selectedProject"]').val() || "";
            var unitStatus = $('#form-search select[name="selectedUnitStatus"]').val() || "";
            var buildStatus = $('#form-search select[name="selectedBuildStatus"]').val() || "";
            var syncQCStatus = $('#form-search select[name="selectedQCSyncStatus"]').val() || "";

            $.ajax({
                url: baseUrl + 'UnitStatusByProject/SearchUnitStatusByProject',
                type: 'POST',
                data: {
                    projectId: projectId,
                    unitStatus: unitStatus,
                    buildStatus: buildStatus,
                    syncQCStatus: syncQCStatus
                },
                success: function (response) {
                    $('#PartialTable').html(response);

                    setTimeout(function () {
                        var table = $('#tbl_1').DataTable({
                            paging: true,
                            lengthChange: true,
                            searching: true,
                            ordering: true,
                            info: true,
                            autoWidth: false,
                            responsive: true,
                            lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                            language: {
                                lengthMenu: "Show _MENU_ rows per page",
                                zeroRecords: "ไม่พบข้อมูล",
                                info: "Showing page _PAGE_ of _PAGES_",
                                infoEmpty: "No records available",
                                infoFiltered: "(filtered from _MAX_ total records)"
                            }
                        });

                        table.page(savedPage).draw(false);

                        // ✅ เรียก callback ถ้ามี
                        if (typeof callback === 'function') {
                            callback();
                        }

                    }, 0);

                    Swal.close();
                    $('#modalSync').modal('hide');
                },
                error: function () {
                    Swal.close();
                    console.error('Error fetching data');
                }
            });
        }

        $(document).on('click', '.open-sync-view-modal', function () {
            showLoadingAlert();
            const unitId = $(this).data('unitid');
            const unitCode = $(this).data('unitcode');
            const project = $(this).data('project');

            $.ajax({
                url:  baseUrl + 'UnitStatusByProject/GetSyncQCDetail', // ✅ แก้ให้ตรงกับ Controller ของคุณ
                method: 'POST',
                data: { UnitID: unitId }, 
                success: function (res) {
                    if (res.success) {
                        const d = res.data;

                       $('#view_projectName').text(project);
                       $('#view_unitCode').text(unitCode);

                       // ✅ Set values for inputs and textarea
                       $('#view_appointmentDate').val(d.QCAppointDate ?? "");
                       $('#view_timeStart').val(d.QCAppointTimeFrom ?? "");
                       $('#view_timeEnd').val(d.QCAppointTimeTo ?? "");
                       $('#view_qc5Date').val(d.QCResponseDate ?? "");
                       $('#view_submit_by').val(d.SubmitBy ?? "");
                       $('#view_remark').val(d.QCRemark ?? "");
                       $('#view_ddl_sync_type').val(d.SyncType ?? "");

                        $('#modalViewSync').modal('show');
                        Swal.close();
                    } else {
                        Swal.close();
                        showErrorAlert('ผิดพลาด!', "ดึงข้อมูลไม่สำเร็จ");
                    }
                },
                error: function () {
                    Swal.close();
                    showErrorAlert('ผิดพลาด!',"เกิดข้อผิดพลาดในการเรียกข้อมูล");
                }
            });
        });

        


    </script>
}
