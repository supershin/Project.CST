<link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/dataTables.bootstrap4.min.css">
<script src="https://kit.fontawesome.com/21fea36ed8.js" crossorigin="anonymous"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>
@model List<Project.ConstructionTracking.Web.Models.StoreProcedureModel.ReportAverageNumberofPassedInspectionsModel>
<style>
    .table-container {
        overflow-x: auto; /* Enable horizontal scrolling */
        overflow-y: auto; /* Enable vertical scrolling */
        max-height: 600px; /* Set max height for vertical scrolling */
    }

    table {
        width: 100%;
        margin: 20px 0;
        border-collapse: collapse;
    }

    .custom-table {
        text-align: center;
        border: 1px solid #ddd;
        padding: 8px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    }

    .custom-table th, .custom-table td {
        padding: 8px; /* Add some padding for better spacing */
        border: 1px solid #dee2e6;
        white-space: nowrap;
        overflow: hidden; /* Hide overflow content */
        text-overflow: ellipsis; /* Show ellipsis (...) for overflow */
       /* max-width: 300px; */
    }

    .custom-table th {
        background-color: #f8f9fa;
        font-size: 0.9rem; /* Adjust to make the table head bigger */
        font-weight: bold;
    }

    .custom-table td {
        font-size: 0.8rem; /* Smaller font size for table data */
        text-align: center;
    }

    .custom-table tbody tr:hover td{
        background-color: #eff584 !important;
    }
</style>

<div class="card" id="custom-card">
    <div class="card-body">
        <!-- Display the row count and Export button -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="row-count">
                <!-- จำนวนรายการทั้งหมด: @Model.Count -->
            </div>
            <div>
                <button class="btn btn-success" id="exportExcel" onclick="exportInspectionResults()">
                    <i class="fas fa-file-excel"></i> Export to Excel
                </button>
            </div>
        </div>
        <div class="table-container">
            <table id="custom-table" class="custom-table">
                <thead>
                    <tr>
                        <th rowspan="2">No.</th>
                        <th rowspan="2">โครงการ</th>
                        <th rowspan="2">ผู้รับเหมา</th>
                        <th colspan="5" class="bg-light">ค่าเฉลี่ยจำนวนครั้งที่ผ่าน</th>
                        <th colspan="5" style="background-color: #fff9db;">จำนวนหลังที่ตรวจผ่าน</th>
                    </tr>
                    <tr>
                        <!-- ค่าเฉลี่ยจำนวนครั้งที่ผ่าน -->
                        <th>QC1</th>
                        <th>QC2</th>
                        <th>QC3</th>
                        <th>QC4</th>
                        <th>QC5</th>
                        <!-- จำนวนหลังที่ตรวจผ่าน -->
                        <th style="background-color: #fff9db;">QC1</th>
                        <th style="background-color: #fff9db;">QC2</th>
                        <th style="background-color: #fff9db;">QC3</th>
                        <th style="background-color: #fff9db;">QC4</th>
                        <th style="background-color: #fff9db;">QC5</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.index</td>
                                <td>@item.ProjectName</td>
                                <td>@item.CompanyVendorName</td>
                                <td>@item.AverageQC1Pass</td>
                                <td>@item.AverageQC2Pass</td>
                                <td>@item.AverageQC3Pass</td>
                                <td>@item.AverageQC4Pass</td>
                                <td>@item.AverageQC5Pass</td>
                                <td style="background-color: #fff9db;">@item.CntUnitQC1Pass</td>
                                <td style="background-color: #fff9db;">@item.CntUnitQC2Pass</td>
                                <td style="background-color: #fff9db;">@item.CntUnitQC3Pass</td>
                                <td style="background-color: #fff9db;">@item.CntUnitQC4Pass</td>
                                <td style="background-color: #fff9db;">@item.CntUnitQC5Pass</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="14" style="text-align: center; font-weight: bold;">
                                ไม่มีข้อมูล
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr id="totalRow">
                        <td colspan="3" style="text-align: center; font-weight: bold;">Summary โครงการ</td>
                        <!-- Totals will be populated dynamically -->
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const table = document.querySelector('.custom-table'); // Select the table
        const tbodyRows = table.querySelectorAll('tbody tr'); // All rows in tbody
        const totalRow = document.getElementById('totalRow'); // The summary row

        // Initialize sums for each column that needs to be calculated
        const columnSums = Array.from({ length: 10 }, () => 0); // We have 10 columns to sum up

        // Loop through each row in the table body
        tbodyRows.forEach(row => {
            const cells = row.querySelectorAll('td'); // Get all cells in the row
            cells.forEach((cell, index) => {
                if (index >= 3 && index <= 12) { // Indices for the 10 columns to calculate
                    const value = parseFloat(cell.textContent) || 0; // Parse value or default to 0
                    columnSums[index - 3] += value; // Sum values (adjust index to match columnSums array)
                }
            });
        });

        // Populate the total row
        columnSums.forEach((sum, index) => {
            const totalCell = document.createElement('td');

            // Display sum as integer if it has no decimals, otherwise show 2 decimal places
            if (sum % 1 === 0) {
                totalCell.textContent = sum === 0 ? "" : sum.toFixed(0); // Integer
            } else {
                totalCell.textContent = sum.toFixed(2); // Decimal
            }

            totalCell.style.textAlign = index === 0 ? 'left' : 'center'; // Align the first column left, others center
            totalRow.appendChild(totalCell);
        });
    });


</script>





