@model List<Project.ConstructionTracking.Web.Models.StoreProcedureModel.UnitFormStatusModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutSite.cshtml";
}

<style>

    .fixed-size-btn {
        width: 80px; /* Adjust the width as needed */
        height: 30px;
    }

    .card {
        border: none;
        border-radius: 10px;
    }

    .carousel-item {
        flex: 1 0 auto;
        text-align: center;
    }

    .status-text {
        font-size: 1em;
    }


    .status-dot {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto;
        border: none;
        outline: none;
        font-size: 18px;
    }
</style>

<div class="page-wrapper">
    <div class="page-header d-print-none">
        <div class="card bg-primary text-primary-fg">
            <div class="card-stamp">
                <div class="card-stamp-icon bg-white text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-home-heart">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M21 12l-9 -9l-9 9h2v7a2 2 0 0 0 2 2h6" />
                        <path d="M9 21v-6a2 2 0 0 1 2 -2h2c.39 0 .754 .112 1.061 .304" />
                        <path d="M19 21.5l2.518 -2.58a1.74 1.74 0 0 0 0 -2.413a1.627 1.627 0 0 0 -2.346 0l-.168 .172l-.168 -.172a1.627 1.627 0 0 0 -2.346 0a1.74 1.74 0 0 0 0 2.412l2.51 2.59z" />
                    </svg>
                </div>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="d-flex flex-row align-items-baseline">
                        <form id="form-UnitStatusByProject" method="post" asp-controller="UnitStatusByProject" asp-action="Index">
                            <button class="status-dot bg-transparent">
                                <i class="fa-solid fa-chevron-left fa-xl" style="color: #f7f7f7;"></i>
                            </button>
                        </form>
                    </div>
                    <div class="d-block d-sm-flex align-items-baseline custom-heading">
                        <h1>หน้าจอ Unit status แสดงราย Unit (show on website)</h1>
                    </div>
                    <div class="align-items-right">

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container">
            <partial name="PartialTable" model="Model" />
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#example').DataTable({
            "paging": true,
            "lengthChange": true,
            "searching": true,
            "ordering": false,
            "info": true,
            "autoWidth": false,
            "responsive": true,
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]],
            "language": {
                "lengthMenu": "Show _MENU_ rows per page",
                "zeroRecords": "No matching records found",
                "info": "Showing page _PAGE_ of _PAGES_",
                "infoEmpty": "No records available",
                "infoFiltered": "(filtered from _MAX_ total records)"
            }
        });

        // Navbar Active Class Logic
        const desktopNavItem = document.getElementById('nav-Desktop');
        const unitPaymentNavItem = document.getElementById('nav-UnitStatus');

        if (desktopNavItem) {
            desktopNavItem.classList.add('active'); // Make Desktop nav active
        }
        if (unitPaymentNavItem) {
            unitPaymentNavItem.classList.add('active'); // Make UnitStatus nav active
        }
    });
</script>