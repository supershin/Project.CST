@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutSite.cshtml";
    var DDLExtStatusGrPayment = ViewBag.DDLExtStatusGrPayment;
}
@model List<Project.ConstructionTracking.Web.Models.StoreProcedureModel.WorkPeriodModel>

<style>
    .card {
        border: none;
        border-radius: 10px;
    }

    .selectize-control .selectize-input {
        min-height: 41px; /* Adjust this value as needed */
        padding: 8px 12px; /* Add padding for better spacing */
        line-height: normal; /* Ensure text isn't vertically clipped */
        font-size: 14px; /* Optional: Adjust font size */
    }

    .selectize-control .selectize-dropdown {
        font-size: 14px; /* Optional: Adjust dropdown font size if needed */
    }

    .table-bordered {
        border: 2px solid #dee2e6; /* Add a border to the entire table */
    }

    .table-bordered th,
    .table-bordered td {
        border: 1px solid #dee2e6; /* Add a border to each cell */
    }

</style>
<title>Unit Payment</title>
<div class="page-wrapper">
    <div class="page-header d-print-none">
        <div class="card bg-primary text-primary-fg">
            <div class="card-stamp">
                <div class="card-stamp-icon bg-white text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-home-heart">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M21 12l-9 -9l-9 9h2v7a2 2 0 0 0 2 2h6" />
                        <path d="M9 21v-6a2 2 0 0 1 2 -2h2c.39 0 .754 .112 1.061 .304" />
                        <path d="M19 21.5l2.518 -2.58a1.74 1.74 0 0 0 0 -2.413a1.627 1.627 0 0 0 -2.346 0l-.168 .172l-.168 -.172a1.627 1.627 0 0 0 -2.346 0a1.74 1.74 0 0 0 0 2.412l2.51 2.59z" />
                    </svg>
                </div>
            </div>
            <div class="card-body">
                <h1>Unit Payment</h1>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl mb-2">
            <div class="card" id="card-filter">
                <div class="card-body">
                    <div class="row">
                        <div class="col-6 col-sm-3 mb-2">
                            <select id="DDLProjectID">
                                <option value="">กรุณาเลือก</option>
                                @foreach (var item in ViewBag.DDLProject)
                                {
                                    <option value="@item.ValueGuid">@item.Text</option>
                                }
                            </select>
                            <input type="hidden" id="selectedProjectId">
                        </div>
                        <div class="col-6 col-sm-3 mb-2">
                            <input type="text" id="txtunitsearch" placeholder="ค้นหา Unit..." class="form-control">
                        </div>
                        <div class="col-6 col-sm-3 mb-2">
                            <div class="mb-3">
                                <select class="form-select" id="DDLStatusGrPayment">
                                    <option value="">ทั้งหมด</option>
                                    @foreach (var item in DDLExtStatusGrPayment)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3 mb-2">
                            <button class="btn btn-primary w-100" id="searchButton">
                                <i class="fas fa-search"></i> ค้นหา
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container-xl mb-2" id="PartialTableReport">
            <partial name="PartialTable" model="Model" />
        </div>
    </div>
</div>
<!-- ModalGRPayment -->
<div class="modal fade" id="ModalGRPayment" tabindex="-1" aria-labelledby="ModalGRPaymentLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 100vw; margin: auto;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalGRPaymentLabel">บันทึกเลข GR</h5>
                <button type="button" class="btn-close" id="closeModalGRPayment" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mt-3">
                    <!-- Left Container (Form Section) -->
                    <div class="col-12 col-md-4 mb-3" id="leftContainer">
                        <div class="card">
                            <div class="card-body">
                                <form id="accountForm">
                                    <div class="mb-3">
                                        <div class="row">
                                            <div class="col-12 col-lg-6 mb-3">
                                                <label for="projectName" class="form-label">โครงการ</label>
                                                <input type="text" class="form-control" id="projectName" placeholder="Project Name" value="" disabled>
                                                <input type="hidden" id="hdProjectID" />
                                            </div>
                                            <div class="col-12 col-lg-6 mb-3">
                                                <div class="row">
                                                    <div class="col-12 col-md-6 mb-3">
                                                        <label for="unit" class="form-label">แปลง</label>
                                                        <input type="text" class="form-control" id="unitcode" placeholder="Unit Code" value="" disabled>
                                                        <input type="hidden" id="hdUnitID" />
                                                        <input type="hidden" id="hdUnitFormID" />
                                                    </div>
                                                    <div class="col-12 col-md-6 mb-3">
                                                        <label for="unit" class="form-label">งวด</label>
                                                        <input type="text" class="form-control" id="formName" placeholder="งวดที่" value="" disabled>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="row">
                                            <div class="col-12 col-lg-6 mb-3">
                                                <label for="company" class="form-label">บริษัท</label>
                                                <input type="text" class="form-control" id="companyvenderName" placeholder="Company Vender Name" value="" disabled>
                                            </div>
                                            <div class="col-12 col-lg-6 mb-3">
                                                <label for="contractor" class="form-label">ผู้รับเหมา</label>
                                                <input type="text" class="form-control" id="venderName" placeholder="Vender Name" value="" disabled>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="row">
                                            <div class="col-12 col-lg-6 mb-3">
                                                <label for="poInput" class="form-label">
                                                    PO Input <span style="color: red;">*</span>
                                                </label>
                                                <input type="text" class="form-control" id="poInput" placeholder="กรุณาระบุ PO">
                                            </div>
                                            <div class="col-12 col-lg-6 mb-3">
                                                <label for="grInput" class="form-label">
                                                    GR Input <span style="color: red;">*</span>
                                                </label>
                                                <input type="text" class="form-control" id="grInput" placeholder="กรุณาระบุ GR">
                                            </div>
                                            <div class="col-6 mb-3">
                                                <label for="percentInput" class="form-label">
                                                    Percent <span style="color: red;">*</span>
                                                </label>
                                                <select id="DDLPercentPaymentID" class="form-control">
                                                    <option value="-1">กรุณาเลือก</option>
                                                    @foreach (var item in ViewBag.DDLPercentPayment)
                                                    {
                                                        <option value="@item.Text">@item.Text</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label for="remark" class="form-label">เพิ่ม remark เพื่อระบุให้กับทาง vendor portal ทราบ</label>
                                        <textarea class="form-control" id="remark" rows="3"></textarea>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <button type="button" class="btn btn-secondary" onclick="onClickClearinputsaveGR()">ล้าง</button>
                                        <button type="button" class="btn btn-success" onclick="onClickSaveGRPayment()">บันทึก</button>
                                    </div>
                                </form>

                            </div>
                        </div>
                    </div>

                    <!-- Right Container (Table Section) -->
                    <div class="col-12 col-md-8" id="rightContainer">
                        <div id="PartialTableListGRPayment">
                            @await Html.PartialAsync("PartialTableListUnitFormGRPayment", ViewData["ModelTableListUnitFormGRPayment"])
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                <button type="button" class="btn btn-primary" id="toggleLeftContainer">แสดงเฉพาะตารางเบิก</button>
            </div>
        </div>
    </div>
</div>
<!-- ModalViewGRPaymentLabel -->
<div class="modal fade" id="ModalViewGRPayment" tabindex="-1" aria-labelledby="ModalViewGRPaymentLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: auto; margin: auto;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalGRPaymentLabel">ข้อมูลเลข GR</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="page-content page-container" id="page-content">
                    <div class="padding">
                        <div class="row container d-flex justify-content-center">
                            <div class="col-12 grid-margin stretch-card">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-block d-sm-flex align-items-baseline custom-heading">
                                            <h3 class="mb-0 header-text" id="viewProjectName">ProjectName</h3>
                                            <div class="text-muted">
                                                <p class="text-yellow d-block d-sm-inline ms-sm-2 mb-0" id="viewUnitcode">Unitcode</p>
                                                <p class="text-yellow d-block d-sm-inline ms-sm-2 mb-0" id="viewFormname">Formname</p>
                                            </div>
                                        </div>
                                        <p class="card-description" id="viewVenderCompany">
                                            VenderCompany And VenderName
                                        </p>
                                        <div class="table-responsive">
                                            <table class="table table-hover table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th>ลำดับ</th>
                                                        <th>PO</th>
                                                        <th>GR</th>
                                                        <th>Percent</th>
                                                        <th>หมายเหตุ</th>
                                                        <th>สถานะ</th>
                                                        <th>วันที่บันทึก GR ล่าสุด</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="TableBodyViewGRPayment">
                                                    <!-- Rows will be appended here dynamically -->
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <link href="https://cdn.jsdelivr.net/npm/selectize@0.12.6/dist/css/selectize.default.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/selectize@0.12.6/dist/js/standalone/selectize.min.js"></script>
    <script src="~/js/pages/unitpayment.js?ver=@DateTime.Now.Ticks.ToString()"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Toggling Left and Right Containers
            var leftContainer = document.getElementById('leftContainer');
            var rightContainer = document.getElementById('rightContainer');
            var toggleButton = document.getElementById('toggleLeftContainer');

            toggleButton.addEventListener('click', function () {
                if (leftContainer.style.display === 'none' || leftContainer.classList.contains('d-none')) {
                    // Show the left container and adjust the right container
                    leftContainer.style.display = 'block';
                    leftContainer.classList.remove('d-none');
                    rightContainer.classList.remove('col-12');
                    rightContainer.classList.add('col-md-8');
                } else {
                    // Hide the left container and expand the right container
                    leftContainer.style.display = 'none';
                    leftContainer.classList.add('d-none');
                    rightContainer.classList.remove('col-md-8');
                    rightContainer.classList.add('col-12');
                }
            });

            // Navbar Active Class Logic
            const desktopNavItem = document.getElementById('nav-Desktop');
            const unitPaymentNavItem = document.getElementById('nav-UnitPayment');

            if (desktopNavItem) {
                desktopNavItem.classList.add('active'); // Make Desktop nav active
            }
            if (unitPaymentNavItem) {
                unitPaymentNavItem.classList.add('active'); // Make UnitPayment nav active
            }
        });
    </script>
}



