<div class="modal fade" id="bigModal" tabindex="-1" aria-labelledby="bigModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 80vw; margin: auto;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bigModalLabel">บันทึกเลข GR</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mt-3">
                    <!-- Left Container (Form Section) -->
                    <div class="col-12 col-md-6 mb-3">
                        <div class="card">
                            <div class="card-body">
                                <form id="accountForm">
                                    <div class="mb-3">
                                        <div class="row">
                                            <div class="col-12 col-sm-6 mb-3">
                                                <label for="projectName" class="form-label">โครงการ</label>
                                                <input type="text" class="form-control" id="projectName" placeholder="Enter project name" value="เอสต้า ซีรีนิตี้ บรมราชชนนี" disabled>
                                            </div>
                                            <div class="col-12 col-sm-6 mb-3">
                                                <div class="row">
                                                    <div class="col-6">
                                                        <label for="unit" class="form-label">Unit</label>
                                                        <input type="text" class="form-control" id="unit" placeholder="Enter unit" value="AA0001" disabled>
                                                    </div>
                                                    <div class="col-6">
                                                        <label for="unit" class="form-label">งวด</label>
                                                        <input type="text" class="form-control" id="unit" placeholder="Enter unit" value="งวดที่ 1" disabled>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="row">
                                            <div class="col-12 col-sm-6 mb-3">
                                                <label for="company" class="form-label">บริษัท</label>
                                                <input type="text" class="form-control" id="company" placeholder="Enter company" value="บริษัท เอ เอส พาวเวอร์ แอสแซท จำกัด" disabled>
                                            </div>
                                            <div class="col-12 col-sm-6 mb-3">
                                                <label for="contractor" class="form-label">ผู้รับเหมา</label>
                                                <input type="text" class="form-control" id="contractor" placeholder="Enter contractor" value="คุณวรเดช หริ่มรุ่งเรือง" disabled>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <div class="row">
                                            <div class="col-12 col-sm-6 mb-3">
                                                <label for="poInput" class="form-label">PO Input</label>
                                                <input type="text" class="form-control" id="poInput" placeholder="Enter PO">
                                            </div>
                                            <div class="col-12 col-sm-6 mb-3">
                                                <div class="row">
                                                    <div class="col-8">
                                                        <label for="grInput" class="form-label">GR Input</label>
                                                        <input type="text" class="form-control" id="grInput" placeholder="Enter GR">
                                                    </div>
                                                    <div class="col-4">
                                                        <label for="percent" class="form-label">Percent</label>
                                                        <input type="text" class="form-control" id="percent" placeholder="Enter percentage">                                                
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label for="remark" class="form-label">เพิ่ม remark เพื่อระบุให้กับทาง vendor portal ทราบ</label>
                                        <textarea class="form-control" id="remark" rows="3"></textarea>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <button type="submit" class="btn btn-success">บันทึก</button>
                                        <button type="button" class="btn btn-secondary">ยกเลิก</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Right Container (Table Section) -->
                    <div class="col-12 col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <div style="overflow-x: auto; max-height: 600px;">
                                    <table class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>บริษัท</th>
                                                <th>ผู้รับเหมา</th>
                                                <th>PO</th>
                                                <th>GR</th>
                                                <th>Percent</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>บริษัท เอ เอส พาวเวอร์ แอสแซท จำกัด</td>
                                                <td>คุณวรเดช หริ่มรุ่งเรือง</td>
                                                <td>PO-123</td>
                                                <td>GR124</td>
                                                <td>80%</td>
                                                <td>Success / Fail</td>
                                                <td>
                                                    <button class="btn btn-primary btn-sm">Edit</button>
                                                    <button class="btn btn-danger btn-sm">Delete</button>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>บริษัท เอ เอส พาวเวอร์ แอสแซท จำกัด</td>
                                                <td>คุณอนุรักษ์ อนันท้าว</td>
                                                <td>PO-125</td>
                                                <td>GR999</td>
                                                <td>20%</td>
                                                <td>Success / Sync</td>
                                                <td>
                                                    <button class="btn btn-primary btn-sm">Edit</button>
                                                    <button class="btn btn-danger btn-sm">Delete</button>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <link href="https://cdn.jsdelivr.net/npm/selectize@0.12.6/dist/css/selectize.default.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/selectize@0.12.6/dist/js/standalone/selectize.min.js"></script>
    <script>
        var ddlProjectData = @Html.Raw(Json.Serialize(ViewBag.DDLProject));
    </script>
    <script src="~/js/pages/unitpayment.js?ver=@DateTime.Now.Ticks.ToString()"></script>
}



