@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutSite.cshtml";
}
@model List<Project.ConstructionTracking.Web.Models.StoreProcedureModel.WorkPeriodModel>
<style>
    .card {
        border: none;
        border-radius: 10px;
    }

</style>
<title>Unit Payment</title>
<div class="page-wrapper">
    <div class="page-header d-print-none">
        <div class="card bg-primary text-primary-fg">
            <div class="card-stamp">
                <div class="card-stamp-icon bg-white text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-home-heart">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M21 12l-9 -9l-9 9h2v7a2 2 0 0 0 2 2h6" />
                        <path d="M9 21v-6a2 2 0 0 1 2 -2h2c.39 0 .754 .112 1.061 .304" />
                        <path d="M19 21.5l2.518 -2.58a1.74 1.74 0 0 0 0 -2.413a1.627 1.627 0 0 0 -2.346 0l-.168 .172l-.168 -.172a1.627 1.627 0 0 0 -2.346 0a1.74 1.74 0 0 0 0 2.412l2.51 2.59z" />
                    </svg>
                </div>
            </div>
            <div class="card-body">
                <h1>Unit Payment</h1>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl mb-2">
            <div class="card" id="card-filter">
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 col-sm-4 mb-2">
                            <select id="DDLProjectID">
                                <option value="">กรุณาเลือก</option>
                                @foreach (var item in ViewBag.DDLProject)
                                {
                                    <option value="@item.ValueGuid">@item.Text</option>
                                }
                            </select>
                            <input type="hidden" id="selectedProjectId">
                        </div>
                        <div class="col-8 col-sm-6 mb-2">
                            <select id="ddlunit" placeholder="ค้นหาแปลง...">
                                <option value="">กรุณาเลือกหน่วย</option>
                            </select>
                            <input type="hidden" id="selectedUnitIds" />
                        </div>
                        <div class="col-4 col-sm-2 mb-2">
                            <button class="btn btn-primary" id="searchButton">
                                <i class="fas fa-search"></i> ค้นหา
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container-xl mb-2" id="PartialTableReport">
            <partial name="PartialTable" model="Model" />
        </div>
    </div>
</div>
@section scripts {
    <link href="https://cdn.jsdelivr.net/npm/selectize@0.12.6/dist/css/selectize.default.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/selectize@0.12.6/dist/js/standalone/selectize.min.js"></script>
    <script>
        var ddlProjectData = @Html.Raw(Json.Serialize(ViewBag.DDLProject));
    </script>
    <script src="~/js/pages/unitpayment.js?ver=@DateTime.Now.Ticks.ToString()"></script>
}



