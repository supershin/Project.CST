<style>
    .table-container {
        overflow-x: auto; /* Enable horizontal scrolling */
        overflow-y: auto; /* Enable vertical scrolling */
        max-height: 600px; /* Set max height for vertical scrolling */
    }

    table {
        width: 100%;
        margin: 20px 0;
        border-collapse: collapse;
    }

    .custom-table {
        text-align: center;
        border: 1px solid #ddd;
        padding: 8px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    }

    .custom-table th, .custom-table td {
        padding: 8px; /* Add some padding for better spacing */
        border: 1px solid #dee2e6;
        white-space: nowrap;
        overflow: hidden; /* Hide overflow content */
        text-overflow: ellipsis; /* Show ellipsis (...) for overflow */
        max-width: 300px; /* Set max width */
    }

    .custom-table th {
        background-color: #f8f9fa;
        font-size: 0.9rem; /* Adjust to make the table head bigger */
        font-weight: bold;
    }

    .custom-table td {
        font-size: 0.8rem; /* Smaller font size for table data */
        text-align: left;
    }

    .custom-table tbody tr:hover {
        background-color: #eff584;
    }
</style>
<div class="card" id="custom-card">
    <div class="card-body">
        <!-- Display the row count -->
        <div class="row-count">
            จำนวนรายการทั้งหมด: @Model.Count
        </div>
        <div class="table-container">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>โครงการ</th>
                        <th>แปลงที่</th>
                        <th>ผู้รับเหมา</th>
                        <th>วิศวกรผู้ควบคุมงาน</th>
                        <th>สถานะขาย <br>(จอง สัญญา โอน ห้องว่าง)</th>
                        <th>วันกำหนดโอน <br>(ตามสัญญา)</th>
                        <th>แผนเริ่ม<br>ตามสัญญา</th>
                        <th>แผนสิ้นสุด<br>ตามสัญญา</th>
                        <th>สถานะงวดงาน<br>ที่ผ่านล่าสุด</th>
                        <th>% Progress ในแผน</th>
                        <th>% Progress จริง</th>
                        <th>% Delay/ahead</th>
                        <th>งวดที่เบิกล่าสุด</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.index</td>
                                <td>@item.ProjectName</td>
                                <td>@item.UnitCode</td>
                                <td>@item.CompanyName</td>
                                <td>@item.PEName</td>
                                <td>@item.UnitStatus</td>
                                <td>@item.TransferDate</td>
                                <td>@item.StartDatePlan</td>
                                <td>@item.EndDatePlan</td>
                                <td>@item.FormActual</td>
                                <td>@item.ProgressPlan</td>
                                <td>@item.ProgressActual</td>
                                <td>@item.DelayAhead</td>
                                <td>@item.LastFormTransfer</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="14" style="text-align: center; font-weight: bold;">
                                ไม่มีข้อมูล
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


