@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutSite.cshtml";
    var ListDDLProject = ViewBag.ListDDLProject;
}
<style>

    .card {
        border: none;
        border-radius: 10px;
    }

    /* Hover Zoom Effect */
    .card-img-container {
        overflow: hidden;
        position: relative;
    }

     /* Active Image Border */
    .card-img-container.active {
        border: 3px solid blue;
        border-radius: 5px; /* Optional: to make it look nice */
    }

    .card-img-top {
        transition: transform 0.3s ease-in-out;
    }

    .card-img-container:hover .card-img-top {
        transform: scale(1.1); /* Zooms the image */
    }

    #partialContainerOpenShowImageProjectFloorPlan {
        position: relative; /* Markers are positioned relative to this container */
        overflow: hidden; /* Prevent markers from spilling outside the container */
    }

    .marker-icon {
        pointer-events: auto; /* Enable interactivity */
        z-index: 10; /* Ensure markers appear above the canvas */
    }

    /* Modal container */
    #markerModal {
        display: none; /* Hidden by default */
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.4); /* Black with opacity */
    }

    /* Modal content */
    #modalContent {
        background-color: #fefefe;
        margin: 15% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 40%;
        border-radius: 10px;
    }

    /* Close button */
    #closeButton {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }

    #closeButton:hover,
    #closeButton:focus {
        color: black;
        text-decoration: none;
    }


</style>
<title>แผนผังโครงการ</title>
<div class="page-wrapper">
    <div class="page-header">
        <div class="card bg-primary text-primary-fg">
            <div class="card-stamp">
                <div class="card-stamp-icon bg-white text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-home-heart">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M21 12l-9 -9l-9 9h2v7a2 2 0 0 0 2 2h6" />
                        <path d="M9 21v-6a2 2 0 0 1 2 -2h2c.39 0 .754 .112 1.061 .304" />
                        <path d="M19 21.5l2.518 -2.58a1.74 1.74 0 0 0 0 -2.413a1.627 1.627 0 0 0 -2.346 0l-.168 .172l-.168 -.172a1.627 1.627 0 0 0 -2.346 0a1.74 1.74 0 0 0 0 2.412l2.51 2.59z" />
                    </svg>
                </div>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center">
                <h1 class="m-0 text-center">แผนผังโครงการ  (Show) </h1>
            </div>
        </div>
    </div>
    <div class="container mt-4">
        <div class="form-label"><h1>แผนผังโครงการทั้งหมด</h1></div>
        <div class="row">
            <div class="col-12 col-md-6">
                <select id="projectSelect" class="form-select" onchange="handleProjectChange()">
                    <option value="">-- กรุณาเลือกโครงการ --</option>
                    @foreach (var item in ListDDLProject)
                    {
                        <option value="@item.ValueGuid">@item.Text</option>
                    }
                </select>
            </div>
        </div>
        <div id="projectImageContainer" class="mt-4"></div>
    </div>
    <div id="partialContainerOpenShowImageProjectFloorPlan" class="container mt-4" style="display: none;">
        <!-- The partial content will be dynamically loaded here -->
        <partial name="PartialCanvasShowImageProjectBluePrint" />
    </div>
    <!-- Modal Structure -->
    <div id="markerModal">
        <div id="modalContent">
            <span id="closeButton">&times;</span>
            <h2 id="modalTitle"></h2>
            <p id="modalDescription"></p>
        </div>
    </div>



</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // Your existing initialization code (if any)
        });

        let canvas, ctx;
        let backgroundImage;
        let markers = [];
        let ClickProjectFloorPlanID;

        function handleProjectChange() {
            $("#partialContainerOpenShowImageProjectFloorPlan").hide();

            const projectSelect = $("#projectSelect");
            const projectId = projectSelect.val();
            const container = $("#projectImageContainer");
            const partialContainer = $("#partialContainer");

            if (projectId !== "") {
                $.ajax({
                    url: `${baseUrl}ProjectFloorPlan/GetListImageProjectFloorPlan`,
                    type: "GET",
                    data: { ProjectID: projectId },
                    beforeSend: function () {
                        container.empty();
                    },
                    success: function (html) {
                        container.html(html);
                        partialContainer.show();
                    },
                    error: function (xhr, status, error) {
                        console.error("Error fetching data:", error);
                        container.html("<p class='text-danger'>เกิดข้อผิดพลาดในการโหลดข้อมูล</p>");
                    },
                });
            } else {
                partialContainer.hide();
                container.empty().html("");
                return;
            }
        }

        function loadCanvas(imagePath) {
            canvas = document.getElementById("blueprintCanvas");
            ctx = canvas.getContext("2d");

            const image = new Image();
            image.src = imagePath;

            image.onload = () => {
                canvas.width = image.width;
                canvas.height = image.height;
                ctx.drawImage(image, 0, 0);

                backgroundImage = image;
                drawCanvas(); // Ensure the canvas is drawn after loading the image
            };

            // Add event listener for mouse movements
            canvas.addEventListener('mousemove', handleMouseMove);
            // Add event listener for click events
            canvas.addEventListener('click', handleCanvasClick);
        }

        function onClickOpenShowImageProjectFloorPlan(imagePath, ProjectFloorPlanID) {
            ClickProjectFloorPlanID = ProjectFloorPlanID;

            document.querySelectorAll(".card-img-container").forEach(container => {
                container.classList.remove("active");
            });

            const clickedImageContainer = event.target.closest(".card-img-container");
            if (clickedImageContainer) {
                clickedImageContainer.classList.add("active");
            }

            if (canvas) {
                const newCanvas = canvas.cloneNode(true);
                canvas.parentNode.replaceChild(newCanvas, canvas);
                canvas = newCanvas;
            }

            loadCanvas(imagePath);
            loadBlueprintElements();

            $("#partialContainerOpenShowImageProjectFloorPlan").show();
        }

        function loadBlueprintElements() {
            markers = []; // Reset

            fetch(`${baseUrl}ProjectFloorPlan/GetBlueprintElements?ProjectFloorPlanID=${ClickProjectFloorPlanID}`)
                .then(response => response.json())
                .then(data => {
                    data.forEach(element => {
                        if (element.ElementTypeName === "Marker") {
                            markers.push({
                                x: element.Coordinates[0].X,
                                y: element.Coordinates[0].Y,
                                name: element.UnitName,
                                UnitID: element.UnitID,
                                UnitStatus: element.UnitStatus
                            });
                        }
                    });

                    drawCanvas(); // Redraw the canvas with updated elements
                })
                .catch(error => console.error("Error loading blueprint elements:", error));
        }

        function drawCanvas() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            if (backgroundImage) {
                ctx.drawImage(backgroundImage, 0, 0);
            }
            drawMarkers();
        }

        function drawMarkers() {
            markers.forEach(marker => {
                ctx.beginPath();
                ctx.arc(marker.x, marker.y, 12, 0, Math.PI * 2);

                // Determine the fill color based on UnitStatus
                let fillColor;
                switch (marker.UnitStatus) {
                    case 0:
                        fillColor = 'grey';
                        break;
                    case 1:
                        fillColor = 'green';
                        break;
                    case 2:
                        fillColor = 'red';
                        break;
                    case 3:
                        fillColor = 'yellow';
                        break;
                    default:
                        fillColor = 'black'; // Default color if UnitStatus is undefined or not in the specified cases
                }

                ctx.fillStyle = fillColor;
                ctx.fill();
                ctx.closePath();
            });
        }

        function handleMouseMove(event) {
            const rect = canvas.getBoundingClientRect();
            const mouseX = event.clientX - rect.left;
            const mouseY = event.clientY - rect.top;
            let hovering = false;

            markers.forEach(marker => {
                const dx = mouseX - marker.x;
                const dy = mouseY - marker.y;
                const distance = Math.sqrt(dx * dx + dy * dy);

                if (distance <= 12) { // Assuming marker radius is 12
                    hovering = true;
                }
            });

            canvas.style.cursor = hovering ? 'pointer' : 'default';
        }

        function handleCanvasClick(event) {
            const rect = canvas.getBoundingClientRect();
            const mouseX = event.clientX - rect.left;
            const mouseY = event.clientY - rect.top;

            markers.forEach(marker => {
                const dx = mouseX - marker.x;
                const dy = mouseY - marker.y;
                const distance = Math.sqrt(dx * dx + dy * dy);

                if (distance <= 12) { // Assuming marker radius is 12
                    openModal(marker);
                }
            });
        }

        function openModal(marker) {
            const modal = document.getElementById("markerModal");
            const modalTitle = document.getElementById("modalTitle");
            const modalDescription = document.getElementById("modalDescription");

            modalTitle.textContent = marker.name;
            modalDescription.textContent = `Unit ID: ${marker.UnitID}\nUnit Status: ${marker.UnitStatus}`;

            modal.style.display = "block";

            const closeButton = document.getElementById("closeButton");

            closeButton.onclick = function () {
                modal.style.display = "none";
            };

            window.onclick = function (event) {
                if (event.target == modal) {
                    modal.style.display = "none";
                }
            };
        }


    </script>
}
