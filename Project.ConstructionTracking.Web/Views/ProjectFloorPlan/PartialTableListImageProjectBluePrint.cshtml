@model List<Project.ConstructionTracking.Web.Models.ProjectBluePrint.ProjectBluePrintModel.GetListImageProjectFloorPlanModel>

@if (Model != null && Model.Any())
{
    <div class="row row-cols-3 row-cols-md-4 row-cols-lg-6 g-3">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card position-relative">
                    <div class="card-img-container">
                        <img src="@item.FilePath"
                             class="card-img-top"
                             alt="@item.FileName"
                             onclick="onClickOpenShowImageProjectFloorPlan('@item.FilePath','@item.ProjectFloorPlanID')"
                             style="cursor: pointer;">
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="row row-cols-3 row-cols-md-4 row-cols-lg-6 g-3">
        <div class="col d-flex align-items-center justify-content-center">
            <p class='text-danger'>ไม่มีรูปภาพ</p>
        </div>
    </div>
}

