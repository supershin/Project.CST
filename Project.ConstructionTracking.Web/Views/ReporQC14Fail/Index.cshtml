@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutSite.cshtml";
}
@model List<Project.ConstructionTracking.Web.Models.StoreProcedureModel.ReportQC14FailModel>
<link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
<title>รายการที่ตรวจไม่ผ่านช่วง QC 1-4</title>
<style>
    .card {
        border: none;
        border-radius: 10px;
    }

    .selectize-control .selectize-input {
        min-height: 40px; /* Adjust this value as needed */
        padding: 8px 12px; /* Add padding for better spacing */
        line-height: normal; /* Ensure text isn't vertically clipped */
        font-size: 14px; /* Optional: Adjust font size */
    }

    .selectize-control .selectize-dropdown {
        font-size: 14px; /* Optional: Adjust dropdown font size if needed */
    }
</style>
<div class="page-wrapper">
    <div class="page-header d-print-none">
        <div class="card bg-primary text-primary-fg">
            <div class="card-stamp">
                <div class="card-stamp-icon bg-white text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-home-heart">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M21 12l-9 -9l-9 9h2v7a2 2 0 0 0 2 2h6" />
                        <path d="M9 21v-6a2 2 0 0 1 2 -2h2c.39 0 .754 .112 1.061 .304" />
                        <path d="M19 21.5l2.518 -2.58a1.74 1.74 0 0 0 0 -2.413a1.627 1.627 0 0 0 -2.346 0l-.168 .172l-.168 -.172a1.627 1.627 0 0 0 -2.346 0a1.74 1.74 0 0 0 0 2.412l2.51 2.59z" />
                    </svg>
                </div>
            </div>
            <div class="card-body">
                <h1>รายการที่ตรวจไม่ผ่านช่วง QC 1-4</h1>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl mb-2">
            <div class="card" id="card-filter">
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 col-sm-3 mb-2">
                            <label for="ddlproject" class="form-label">โครงการ<span style="color: red;">*</span></label>
                            <input type="text" id="ddlproject" placeholder="ค้นหาโครงการ...">
                            <input type="hidden" id="selectedProjectId" />
                        </div>
                        <div class="col-6 col-sm-3 mb-2">
                            <label for="ddlcompanyvender" class="form-label">บริษัทผู้รับเหมา</label>
                            <select id="ddlcompanyvender">
                                <option value="">ทั้งหมด</option>
                            </select>
                            <input type="hidden" id="companyvenderId">
                        </div>
                        <div class="col-6 col-sm-3 mb-2">
                            <label for="ddlselecteQC" class="form-label">เลือก QC</label>
                            <select id="ddlselecteQC">
                                <option value="">ทั้งหมด</option>
                            </select>
                            <input type="hidden" id="ddlselecteQCId">
                        </div>
                        <div class="col-6 col-sm-2 mb-2">
                            <label for="startDate" class="form-label">วันที่ตรวจตั้งแต่</label>
                            <input type="text" id="startDate" placeholder="ค้นหาโดยวันที่(เริ่มต้น)" class="form-control">
                        </div>
                        <div class="col-6 col-sm-2 mb-2">
                            <label for="endDate" class="form-label">วันที่ตรวจจนถึง</label>
                            <input type="text" id="endDate" placeholder="ค้นหาโดยวันที่(สิ้นสุด)" class="form-control">
                        </div>
                        <div class="col-12 col-sm-2 mb-2" style="padding-top : 1.6rem;">
                            <button class="btn btn-primary w-100" id="searchButton" onclick="OnclickSearch()">
                                <i class="fas fa-search"></i> ค้นหา
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container-xl mb-2" id="PartialTableReport">
            <partial name="PartialTable" model="Model" />
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/selectize@0.12.6/dist/css/selectize.default.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/selectize@0.12.6/dist/js/standalone/selectize.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script type="text/javascript">

    document.addEventListener('DOMContentLoaded', function () {

        const desktopNavItem = document.getElementById('nav-Report');
        const ReportProjectProgressNavItem = document.getElementById('nav-Report-QC-Group');
        const ReportQCOverviewNavItem = document.getElementById('nav-Report-QC-Details');

        if (desktopNavItem) {
            desktopNavItem.classList.add('active');
        }
        if (ReportProjectProgressNavItem) {
            ReportProjectProgressNavItem.classList.add('active');
        }
        if (ReportQCOverviewNavItem) {
            ReportQCOverviewNavItem.classList.add('active');
        }

        flatpickr("#startDate", {
            dateFormat: "d/m/Y"
        });
        flatpickr("#endDate", {
            dateFormat: "d/m/Y"
        });

        const ddlProject = $('#ddlproject').selectize({
            valueField: 'ValueGuid',
            labelField: 'Text',
            searchField: 'Text',
            options: [],
            create: false,
            placeholder: 'ค้นหาโครงการ...',
            maxItems: 1
        });

        const selectizeProject = ddlProject[0].selectize;

        // Populate project dropdown with data
        const projectData = @Html.Raw(Json.Serialize(ViewBag.DDLProject));
        projectData.forEach(item => {
            selectizeProject.addOption({ ValueGuid: item.ValueGuid, Text: item.Text });
        });

        // Pre-select project
        const selectedProjectId = '@Html.Raw(ViewBag.SelectedProjectId)';
        if (selectedProjectId) {
            selectizeProject.setValue(selectedProjectId);
            document.getElementById('selectedProjectId').value = selectedProjectId;
            $.ajax({
                url: baseUrl + 'ReporQC14Fail/GetDDLVenderByProject',
                data: { ProjectId: selectedProjectId },
                success: function (data) {
                    data.forEach(item => {
                        selectizeCompanyVendor.addOption({ Value: item.Value, Text: item.Text });
                    });
                    selectizeCompanyVendor.enable(); // Enable dropdown after data load
                },
                error: function () {
                    console.log('Failed to load data for Company Vendor dropdown.');
                }
            });
            $.ajax({
                url: baseUrl + 'ReporQC14Fail/GetDDLQCTypeByProject',
                data: { ProjectId: selectedProjectId },
                success: function (data) {
                    data.forEach(item => {
                        selectizeSelecteQC.addOption({ Value: item.Value, Text: item.Text });
                    });
                    selectizeSelecteQC.enable(); // Enable dropdown after data load
                },
                error: function () {
                    console.log('Failed to load data for Company Vendor dropdown.');
                }
            });

        }

        const ddlCompanyVendor = $('#ddlcompanyvender').selectize({
            valueField: 'Value',
            labelField: 'Text',
            searchField: 'Text',
            options: [],
            create: false,
            placeholder: 'ทั้งหมด',
            maxItems: 1
        });

        const ddlSelecteQC = $('#ddlselecteQC').selectize({
            valueField: 'Value',
            labelField: 'Text',
            searchField: 'Text',
            options: [], // Placeholder for options
            create: false, // Disable creation of new options
            placeholder: 'ทั้งหมด', // Placeholder text
            maxItems: null, // Allow multiple selections
            onChange: function (values) {
                // Update the hidden input field with selected values (comma-separated)
                $('#ddlselecteQCId').val(values.join(','));
            }
        });

        const selectizeCompanyVendor = ddlCompanyVendor[0].selectize;
        selectizeCompanyVendor.disable();


        const selectizeSelecteQC = ddlSelecteQC[0].selectize;
        selectizeSelecteQC.disable();

        selectizeProject.on('change', function (value) {
            document.getElementById('selectedProjectId').value = value;

            selectizeCompanyVendor.clear();
            selectizeCompanyVendor.clearOptions();
            selectizeCompanyVendor.disable();

            selectizeSelecteQC.clear();
            selectizeSelecteQC.clearOptions();
            selectizeSelecteQC.disable();

            if (value) {
                $.ajax({
                    url: baseUrl + 'ReporQC14Fail/GetDDLVenderByProject',
                    data: { ProjectId: value },
                    success: function (data) {
                        data.forEach(item => {
                            selectizeCompanyVendor.addOption({ Value: item.Value, Text: item.Text });
                        });
                        selectizeCompanyVendor.enable(); // Enable dropdown after data load
                    },
                    error: function () {
                        console.log('Failed to load data for Company Vendor dropdown.');
                    }
                });

                $.ajax({
                    url: baseUrl + 'ReporQC14Fail/GetDDLQCTypeByProject',
                    data: { ProjectId: value },
                    success: function (data) {
                        data.forEach(item => {
                            selectizeSelecteQC.addOption({ Value: item.Value, Text: item.Text });
                        });
                        selectizeSelecteQC.enable(); // Enable dropdown after data load
                    },
                    error: function () {
                        console.log('Failed to load data for QC dropdown.');
                    }
                });


            }
        });



    });

    function OnclickSearch() {
        // Retrieve filter values
        const projectId = document.getElementById('selectedProjectId').value || "";
        const companyVendorId = document.getElementById('ddlcompanyvender').value || "";
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;

        // Retrieve selected QC types from Selectize
        const qcTypeSelectize = $('#ddlselecteQC')[0].selectize;
        const qcTypeIDs = qcTypeSelectize.getValue(); // Get selected values (array)

        // Validate required fields
        if (!projectId) {
            showAlertandClose('กรุณาเลือกโครงการ');
            return;
        }

        showLoadingScreen();

        // AJAX Request to the Controller
        $.ajax({
            url: baseUrl + 'ReporQC14Fail/OnclickSearch',
            type: 'POST',
            data: {
                projectId: projectId,
                CompanyvenderID: companyVendorId,
                qctypeIDs: qcTypeIDs.join(','), // Convert array to comma-separated string
                startdate: startDate,
                enddate: endDate
            },
            success: function (data) {
                $('#PartialTableReport').html(data); // Update the partial view
                Swal.close();
            },
            error: function (error) {
                Swal.close();
                console.error('Search failed:', error);
                showAlertandClose('เกิดข้อผิดพลาดในการค้นหา');
            }
        });
    }



    function exportInspectionResults() {
        const projectId = document.getElementById('selectedProjectId').value;
        const companyVendorId = document.getElementById('ddlcompanyvender').value || "";
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;

        const qcTypeSelectize = $('#ddlselecteQC')[0].selectize;
        const qcTypeIDs = qcTypeSelectize.getValue();

        if (!projectId) {
            showAlertandClose('กรุณาเลือกโครงการการตรวจเพื่อทำการ Export');
            return;
        }

        showLoadingScreen();

        const exportUrl = `ReporQC14Fail/ExportToExcel?projectId=${encodeURIComponent(projectId)}&companyVendorId=${encodeURIComponent(companyVendorId)}&qctypeIDs=${encodeURIComponent(qcTypeIDs)}&startdate=${encodeURIComponent(startDate)}&enddate=${encodeURIComponent(endDate)}`;

        fetch(exportUrl)
            .then(response => {
                if (!response.ok) {
                    Swal.close();
                    showAlertandClose('Export Excel ไม่สำเร็จ');
                    throw new Error('Error occurred during file download.');
                }
                Swal.close();
                return response.blob();
            })
            .then(blob => {
                Swal.close();
                const link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = `รายการที่ตรวจไม่ผ่านช่วงQC1_4.xlsx`;
                link.click();
            })
            .catch(error => {
                Swal.close();
                console.error('Export failed:', error);
                showAlertandClose('การส่งออกข้อมูลล้มเหลว');
            });
    }


</script>