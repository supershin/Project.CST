@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutSite.cshtml";
}
@model List<Project.ConstructionTracking.Web.Models.StoreProcedureModel.ReportProjectPassConditionModel>
<link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
<title>รายงานการผ่านแบบมีเงื่อนไข</title>
<style>
    .card {
        border: none;
        border-radius: 10px;
    }

    .selectize-control .selectize-input {
        min-height: 40px; /* Adjust this value as needed */
        padding: 8px 12px; /* Add padding for better spacing */
        line-height: normal; /* Ensure text isn't vertically clipped */
        font-size: 14px; /* Optional: Adjust font size */
    }

    .selectize-control .selectize-dropdown {
        font-size: 14px; /* Optional: Adjust dropdown font size if needed */
    }

</style>

<div class="page-wrapper">
    <div class="page-header d-print-none">
        <div class="card bg-primary text-primary-fg">
            <div class="card-stamp">
                <div class="card-stamp-icon bg-white text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-home-heart">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M21 12l-9 -9l-9 9h2v7a2 2 0 0 0 2 2h6" />
                        <path d="M9 21v-6a2 2 0 0 1 2 -2h2c.39 0 .754 .112 1.061 .304" />
                        <path d="M19 21.5l2.518 -2.58a1.74 1.74 0 0 0 0 -2.413a1.627 1.627 0 0 0 -2.346 0l-.168 .172l-.168 -.172a1.627 1.627 0 0 0 -2.346 0a1.74 1.74 0 0 0 0 2.412l2.51 2.59z" />
                    </svg>
                </div>
            </div>
            <div class="card-body">
                <h1>Report Project Pass Condition</h1>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl mb-2">
            <div class="card" id="card-filter">
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 col-sm-2 mb-2">
                            <input type="text" id="ddlproject" placeholder="ค้นหาโครงการ...">
                            <input type="hidden" id="selectedProjectId" />
                        </div>
                        <div class="col-12 col-sm-3 mb-2">
                            <input type="text" id="ddlStatus" placeholder="ค้นหาสถานะ...">
                            <input type="hidden" id="selectedStatusIds" />
                        </div>
                        <div class="col-12 col-sm-2 mb-2">
                            <input type="text" id="txtunitsearch" placeholder="ค้นหา Unit..." class="form-control">
                        </div>
                        <div class="col-6 col-sm-2 mb-2">
                            <input type="text" id="startDate" placeholder="วันที่ส่งเรื่อง (เริ่มต้น)" class="form-control">
                        </div>
                        <div class="col-6 col-sm-2 mb-2">
                            <input type="text" id="endDate" placeholder="วันที่ส่งเรื่อง (สิ้นสุด)" class="form-control">
                        </div>
                        <div class="col-12 col-sm-1">
                            <button class="btn btn-primary w-100" id="searchButton">
                                <i class="fas fa-search"></i> ค้นหา
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container-xl mb-2" id="PartialTableReport">
            <partial name="PartialTable" model="Model" />
        </div>
    </div>
</div>
<link href="https://cdn.jsdelivr.net/npm/selectize@0.12.6/dist/css/selectize.default.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/selectize@0.12.6/dist/js/standalone/selectize.min.js"></script>
 <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script type="text/javascript">

    function init(){ 
        $("#exportExcel").unbind('click');
        document.getElementById('exportExcel').addEventListener('click', function () {
            // Get the values from the inputs
            const projectDropdown = $('#ddlproject')[0].selectize;
            const selectedValue = document.getElementById('selectedProjectId').value;
            const projectName = projectDropdown.getItem(selectedValue).text();
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;

            const ddlStatusSelectize = $('#ddlStatus')[0].selectize;
            const selectedStatuses = ddlStatusSelectize.getValue();
            console.log(selectedStatuses);
            // const selectedStatusTexts = ddlStatusSelectize.map(value => ddlStatusSelectize.options[value].text);
            // console.log(selectedStatusTexts);
            // const statusString = selectedStatusTexts.join(',');
            const unitSearch = document.getElementById('txtunitsearch').value;

            // Check if a value is selected
            if (!selectedValue) {
                showAlertandClose('กรุณาเลือกโครงการก่อนทำการ Export');
                return;
            }

            // Show loading indicator
            showLoadingScreen();

            // Use fetch API to get the file and download it with the selected projectId and additional parameters
            fetch(baseUrl + 'ReportProjectPassCondition/ExportToExcel?projectId=' + encodeURIComponent(selectedValue) +
                '&projectName=' + encodeURIComponent(projectName) +
                '&startdate=' + encodeURIComponent(startDate) +
                '&enddate=' + encodeURIComponent(endDate) +
                '&statusIds=' + encodeURIComponent(selectedStatuses) +
                '&unitSearch=' + encodeURIComponent(unitSearch))
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.blob(); // Convert the response to a blob
                })
                .then(blob => {
                    const link = document.createElement('a');
                    link.href = URL.createObjectURL(blob);
                    link.download = 'ReportProjectPassCondition.xlsx'; // Set the file name
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);

                    // Close the loading indicator
                    Swal.close();
                })
                .catch(error => {
                    console.error('Error during the download:', error);
                    // Close the loading indicator
                    Swal.close();
                });
        });
    }

    flatpickr("#startDate", {
        dateFormat: "d/m/Y" // Set format to dd/mm/yyyy
    });
    flatpickr("#endDate", {
        dateFormat: "d/m/Y" // Set format to dd/mm/yyyy
    });

    // Handle the Export to Excel button click

    document.addEventListener('DOMContentLoaded', function () {

        const desktopNavItem = document.getElementById('nav-Report');
        const ReportProjectProgressNavItem = document.getElementById('nav-Report-Project-PassCondition');

        if (desktopNavItem) {
            desktopNavItem.classList.add('active'); // Make Desktop nav active
        }
        if (ReportProjectProgressNavItem) {
            ReportProjectProgressNavItem.classList.add('active'); // Make Report Project PassCondition nav active
        }


        // Project Dropdown Initialization
        const ddlProject = $('#ddlproject').selectize({
            valueField: 'ValueGuid',
            labelField: 'Text',
            searchField: 'Text',
            options: [],
            create: false,
            placeholder: 'ค้นหาโครงการ...',
            maxItems: 1 // Restrict to single selection
        });

        const selectizeProject = ddlProject[0].selectize;
        const projectData = @Html.Raw(Json.Serialize(ViewBag.DDLProject));
        projectData.forEach(item => {
            selectizeProject.addOption({ ValueGuid: item.ValueGuid, Text: item.Text });
        });

        const selectedProjectId = '@Html.Raw(ViewBag.SelectedProjectId)';
        if (selectedProjectId) {
            selectizeProject.setValue(selectedProjectId);
            document.getElementById('selectedProjectId').value = selectedProjectId;
        }

        selectizeProject.on('change', function () {
            const selectedValue = selectizeProject.getValue();
            document.getElementById('selectedProjectId').value = selectedValue;
            document.cookie = `selectedProjectId=${selectedValue}; path=/; expires=${new Date(new Date().setDate(new Date().getDate() + 7)).toUTCString()}`;
        });

        // Status Dropdown Initialization for Multi-Select
        const ddlStatus = $('#ddlStatus').selectize({
            valueField: 'Value',
            labelField: 'Text',
            searchField: 'Text',
            options: [],
            create: false,
            placeholder: 'ค้นหาสถานะ...',
            maxItems: null // Allow multiple selection
        });

        const selectizeStatus = ddlStatus[0].selectize;
        const statusData = @Html.Raw(Json.Serialize(ViewBag.DDLStatusPC));
        statusData.forEach(item => {
            selectizeStatus.addOption({ Value: item.Value, Text: item.Text });
        });

        // Handle the search button click
        document.getElementById('searchButton').addEventListener('click', function () {
            const selectedProjectValue = document.getElementById('selectedProjectId').value;
            const selectedStatusValues = selectizeStatus.getValue();
            // console.log(selectedStatusValues);
            // const selectedStatusString = selectedStatusValues.join(',');
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            const unitSearchValue = document.getElementById('txtunitsearch').value;

            if (!selectedProjectValue) {
                showAlertandClose('กรุณาเลือกโครงการก่อนทำการค้นหา');
                return;
            }

            showLoadingScreen();

            $.ajax({
                url: baseUrl + 'ReportProjectPassCondition/SearchProject',
                type: 'POST',
                data: {
                    projectId: selectedProjectValue,                   
                    startdate: startDate,
                    enddate: endDate,
                    unitsearch: unitSearchValue,
                    status: selectedStatusValues
                },
                success: function (result) {
                    $('#PartialTableReport').html(result);
                    init();
                    Swal.close();
                },
                error: function (xhr, status, error) {
                    console.error('Error during the search:', error);
                    Swal.close();
                }
            });
        });

        init();
    });

</script>







