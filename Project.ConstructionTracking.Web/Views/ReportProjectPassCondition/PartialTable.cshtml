<link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/dataTables.bootstrap4.min.css">
<script src="https://kit.fontawesome.com/21fea36ed8.js" crossorigin="anonymous"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap4.min.js"></script>
@model List<Project.ConstructionTracking.Web.Models.StoreProcedureModel.ReportProjectPassConditionModel>

<style>
    .table-container {
        overflow-x: auto; /* Enable horizontal scrolling */
        overflow-y: auto; /* Enable vertical scrolling */
        max-height: 600px; /* Set max height for vertical scrolling */
    }

    table {
        width: 100%;
        margin: 20px 0;
        border-collapse: collapse;
    }

    .custom-table {
        text-align: center;
        border: 1px solid #ddd;
        padding: 8px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    }

    .custom-table th, .custom-table td {
        padding: 8px; /* Add some padding for better spacing */
        border: 1px solid #dee2e6;
        white-space: nowrap;
        overflow: hidden; /* Hide overflow content */
        text-overflow: ellipsis; /* Show ellipsis (...) for overflow */
       /* max-width: 300px; */
    }

    .custom-table th {
        background-color: #f8f9fa;
        font-size: 0.9rem; /* Adjust to make the table head bigger */
        font-weight: bold;
    }

    .custom-table td {
        font-size: 0.8rem; /* Smaller font size for table data */
        text-align: left;
    }

    .custom-table tbody tr:hover {
        background-color: #eff584;
    }
</style>
<div class="card" id="custom-card">
    <div class="card-body">
        <!-- Display the row count -->
        <div class="row-count">
            จำนวนรายการทั้งหมด: @Model.Count
        </div>
        <div class="table-container">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>แปลงที่</th>
                        <th>งวดที่</th>
                        <th>รายการตรวจ</th>
                        <th>วันที่ PE ส่งเรื่อง</th>
                        <th>เหตุผลจากวิศวกร<br>ผู้ควบคุมงาน</th>
                        <th>วันที่ PM ยืนยัน</th>
                        <th>สถานะ PM ยืนยัน</th>
                        <th>ความคิดเห็นจาก PM</th>
                        <th>วันที่ PJM ยืนยัน</th>
                        <th>สถานะ PJM ยืนยัน</th>
                        <th>ความคิดเห็นจาก <br>PJM Head</th>
                        <th>วันที่ขอปลดล๊อค</th>
                        <th>วันที่อนุมัติปลดล๊อค</th>
                        <th>สถานะปัจจุบัน</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.index</td>
                                <td>@item.UnitCode</td>
                                <td>@item.FormName</td>
                                <td>@item.FormGroupName </td>

                                <td> @item.PEActionDate <br> @item.PEActionName</td>
                                <td>@item.PEPCRemark</td>

                                <td>@item.PMActionDate <br> @item.PMActionName </td>
                                <td>@item.PMStatusIDName</td>
                                <td>@item.PMPCRemark</td>

                                <td>@item.PJMActionDate <br> @item.PJMActionName </td>
                                <td>@item.PJMStatusIDName</td>
                                <td>@item.PJMPCRemark</td>

                                <td>@item.PERequestUnlock</td>
                                <td>@item.PMUnlock</td>
                                <td>@item.PCStatusName</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="14" style="text-align: center; font-weight: bold;">
                                ไม่มีข้อมูล
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


