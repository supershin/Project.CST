@model Project.ConstructionTracking.Web.Models.SendMail.PMRespond
@{

    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        .email-container {
            max-width: 600px;
            margin: 20px auto;
            background-color: #ffffff;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
        }

        .email-header {
            background-color: #1d0e71;
            color: white;
            text-align: center;
            padding: 20px 10px;
        }

        .email-body {
            padding: 20px;
            color: #333;
            line-height: 1.6;
        }

        .email-body p {
            margin: 0 0 10px;
        }

        .email-footer {
            background-color: #f4f4f4;
            text-align: center;
            padding: 10px;
            font-size: 14px;
            color: #777;
        }

        .email-footer a {
            color: #4caf50;
            text-decoration: none;
        }

        .button {
            display: inline-block;
            background-color: #4caf50;
            color: white;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 5px;
            margin-top: 20px;
        }

        .statusReject {
            background-color: #ffe6e6;
            text-align: center;
            padding: 10px;
            border-radius: 5px;
            color: #f44336;
            margin-bottom: 15px;
        }

        .statusApprove {
            background-color: #4caf50;
            text-align: center;
            padding: 10px;
            border-radius: 5px;
            color: white;
            margin-bottom: 15px;
        }

        .remark {
            background-color: #ffcccc;
            padding: 15px;
            border-radius: 5px;
            color: #b71c1c;
            font-weight: bold;
            margin-top: 15px;
            margin-bottom: 15px;
            line-height: 1.5;
        }

        .pcdetailApprove {
            background-color: #4caf50;
            padding: 1px;
            border-radius: 5px;
            margin-bottom: 15px;
            color: white;
        }

        .pcdetailReject {
            background-color: #ffe6e6;
            padding: 1px;
            border-radius: 5px;
            margin-bottom: 15px;
            color: #b71c1c;
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="email-header">
            <h1>Construction Quality Tracking</h1>
        </div>
        <div class="email-body">
            @if (Model.StatusID == SystemConstant.Unit_Form_Status.PM_Reject)
            {
                <div class="statusReject">
                    <h2>สถานะการตรวจ: <span>❌ @Model.StatusName</span></h2>
                </div>
            }
            else if (Model.StatusID == SystemConstant.Unit_Form_Status.PM_Approve || Model.StatusID == SystemConstant.Unit_Form_Status.PM_Sendto_PJM)
            {
                <div class="statusApprove">
                        <h2>สถานะการตรวจ: <span>✅ @Model.StatusName</span></h2>
                </div>
            }

            <p>เรียน (PE) @Model.PEFullname</p>
            <p>ทางเราขอแจ้งให้ทราบผลการตรวจงวดงาน โดยมีรายละเอียดดังนี้:</p>
            <ul>
                <li><strong>ชื่องวดงาน:</strong> @Model.FormName</li>
                <li><strong>PM ตรวจ:</strong> @Model.PMFullname</li>
                <li><strong>เวลาที่ตรวจ:</strong> @Model.ActionDate</li>
                <li><strong>โครงการ:</strong> @Model.ProjectName</li>
                <li><strong>เลขที่แปลง:</strong> @Model.UnitCode</li>
            </ul>
            @if (Model.StatusID == SystemConstant.Unit_Form_Status.PM_Reject)
            {
                <div class="remark">
                    <strong>หมายเหตุ:</strong> @Model.PMRemark
                </div>
            }
            @if (Model.ListPMRespondPassCondition.Count > 0)
            {
                <p>รายการงานที่ผ่านแบบมีเงื่อนมีดังนี้</p>
                foreach (var item in Model.ListPMRespondPassCondition)
                {
                    @if (item.PCStatusID == SystemConstant.Unit_Form_PC_Status.PM_Approve)
                    {
                        <div class="pcdetailApprove">
                            <ul>
                            <li><strong>ชื่องาน:</strong> @item.FormGroupName</li>
                            <li><strong>สถานะ:</strong> @item.PCStatusName</li>
                            <li><strong>เหตุผล(PE):</strong> @item.RemarkPEPassCodition</li>
                            <li><strong>เหตุผล(PM):</strong> @item.RemarkPMPassCodition</li>
                            </ul>
                        </div>
                    }
                    else if (item.PCStatusID == SystemConstant.Unit_Form_PC_Status.PM_Reject)
                    {
                      <div class="pcdetailReject">
                        <ul>
                            <li><strong>ชื่องาน:</strong> @item.FormGroupName</li>
                            <li><strong>สถานะ:</strong> @item.PCStatusName</li>
                            <li><strong>เหตุผล(PE):</strong> @item.RemarkPEPassCodition</li>
                            <li><strong>เหตุผล(PM):</strong> @item.RemarkPMPassCodition</li>
                        </ul>
                     </div>
                    }
                }
            }

            <p>ขั้นตอนต่อไปท่านสามาถเข้าระบบ <a href="https://cqt.assetwise.co.th/cqt">Construction Quality Tracking</a> เพื่อตรวจสอบข้อมูลเพิ่มเติมหรือตรวจงวดงานในครั้งงวดถัดไป</strong></p>
        </div>
        <div class="email-footer">
            <p>Best Regard,</p>
            <p>Construction Quality Tracking</p>
        </div>
    </div>
</body>
</html>
