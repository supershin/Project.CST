@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutSite.cshtml";
    var ProjectID = ViewBag.ProjectID;
    var ProjectName = ViewBag.ProjectName;
    var UnitID = ViewBag.UnitID;
    var UnitFormID = ViewBag.UnitFormID;
    var UnitCode = ViewBag.UnitCode;
    var FormID = ViewBag.FormID;
    var FormName = ViewBag.FormName;
    var UnitFormStatusID = ViewBag.UnitFormStatusID;
    var Actiondate = ViewBag.Actiondate;
    var PEActionBy = ViewBag.PEActionBy;
    var comeFrom = ViewBag.comeFrom;
    var ActiondatePm = ViewBag.ActiondatePm;
    var ActiondatePJm = ViewBag.ActiondatePJm;
    var Grade = ViewBag.Grade;
    var LockStatusID = ViewBag.LockStatusID;
    var VenderName = ViewBag.VenderName;
    var CompanyName = ViewBag.CompanyName;
    var PM_Remarkaction = ViewBag.PM_Remarkaction;
    var PM_Actiontype = ViewBag.PM_Actiontype;
    var PE_Actiontype = ViewBag.PE_Actiontype;
    var PJM_Remarkaction = ViewBag.PJM_Remarkaction;
    var PJM_Actiontype = ViewBag.PJM_Actiontype;
    var PCAll = ViewBag.PCAll;
    var PCALLPASS = ViewBag.PCALLPASS;
    var PCUnlock = ViewBag.PCUnlock;
    var ListQCData = ViewBag.ListQCData;
}

@model Project.ConstructionTracking.Web.Models.ApproveFormcheckModel

<style>
    .card {
        border: none;
        border-radius: 10px;
        padding: 10px;
    }

    .text-yellow {
        color: yellow;
    }

    .custom-heading {
        line-height: 1.2;
    }

    .status-dot {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto;
        border: none;
        outline: none;
        font-size: 20px;
    }

    .drop-zone {
        border: 2px dashed #007bff;
        border-radius: 5px;
        padding: 6px;
        text-align: center;
        cursor: pointer;
    }

    .align-center {
        display: flex;
        align-items: center;
    }

    .align-center .material-icons {
        margin-right: 8px;
    }

    .drop-zone-text {
        margin-bottom: 10px;
    }

    .drop-zone-input {
        display: none;
    }

    .preview-container {
        margin-top: 10px;
    }

    .preview-image {
        position: relative;
        display: inline-block;
        margin-right: 10px;
        margin-bottom: 10px;
        max-width: 100px;
        max-height: 100px;
    }

    .preview-image img {
        max-width: 100%;
        max-height: 100%;
        border: 1px solid #ddd;
        border-radius: 5px;
        display: block;
    }

    .remove-button {
        position: absolute;
        top: 0;
        right: 0;
        background: rgba(255, 0, 0, 0.8);
        color: white;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        font-size: 14px;
        width: 24px;
        height: 24px;
        line-height: 18px;
        text-align: center;
        padding: 0;
    }

    .BackButton {
        width: 50px; /* Set a fixed width */
        height: 50px; /* Set a fixed height */
        background-color: white;
        border-radius: 50%;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        border: none;
        display: flex; /* Align the icon */
        align-items: center;
        justify-content: center;
        padding: 0; /* Remove padding for a perfect circle */
        cursor: pointer; /* Add cursor pointer for better UX */
    }

    .form-control[readonly] {
        background-color: #e9ecef; /* Light background for readonly input */
        cursor: not-allowed; /* Change cursor to indicate non-editable field */
    }

    .card {
        height: 100%;
    }

    .dynamic-row {
        display: flex;
        gap: 15px;
    }

    .card-detail {
        flex: 1;
        max-width: 420px;
        height: auto;
    }

    .card-image {
        width: 400px;
        height: auto;
    }

    .card-image img {
        width: 100%;
        max-width: 100%;
        height: auto;
    }

    .custom-label {
        background-color: red; /* Red background */
        color: white; /* White text color */
        font-size: 20px; /* Keep the font size */
        padding: 5px; /* Add some padding around the text */
        border-radius: 3px; /* Optional: add rounded corners */
        text-align: center; /* Center the text within the label */
    }

</style>

<div class="page-wrapper">
    <!-- Page header -->
    <button class="fixedButton" onclick="openModalChat('@UnitFormID','@FormID','@FormName','@UnitCode')">
        <i id="chatIcon" class="fa-solid fa-message fa-xl"></i>
    </button>
    <div class="page-header d-print-none">
        <div class="card bg-primary text-primary-fg">
            <div class="card-stamp">
                <div class="card-stamp-icon bg-white text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-home-heart">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M21 12l-9 -9l-9 9h2v7a2 2 0 0 0 2 2h6" />
                        <path d="M9 21v-6a2 2 0 0 1 2 -2h2c.39 0 .754 .112 1.061 .304" />
                        <path d="M19 21.5l2.518 -2.58a1.74 1.74 0 0 0 0 -2.413a1.627 1.627 0 0 0 -2.346 0l-.168 .172l-.168 -.172a1.627 1.627 0 0 0 -2.346 0a1.74 1.74 0 0 0 0 2.412l2.51 2.59z" />
                    </svg>
                </div>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="d-flex flex-row align-items-baseline">
                        @if (comeFrom == "SummaryUnitForm" || ViewBag.UserRole == SystemConstant.UserRole.PE.ToString())
                        {
                            <form asp-controller="Unitlist" asp-action="GoToByRole" method="post">
                                <input type="hidden" name="projectId" id="projectId" value="@ProjectID" />
                                <input type="hidden" name="projectName" value="@ProjectName" />
                                <input type="hidden" name="unitId" value="@UnitID" />
                                <input type="hidden" name="UnitCode" value="@UnitCode" />
                                <input type="hidden" name="UnitStatusName" value="" />
                                <button class="status-dot bg-transparent">
                                    <i class="fa-solid fa-chevron-left fa-xl" style="color: #f7f7f7;"></i>
                                </button>
                            </form>
                        }
                        else if (ViewBag.UserRole == SystemConstant.UserRole.PJM.ToString())
                        {
                            <form action="@Url.Action("index","MyTaskPJM")" method="post">
                                <button class="status-dot bg-transparent">
                                    <i class="fa-solid fa-chevron-left fa-xl" style="color: #f7f7f7;"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <form action="@Url.Action("index","MyTaskPM")" method="post">
                                <button class="status-dot bg-transparent">
                                    <i class="fa-solid fa-chevron-left fa-xl" style="color: #f7f7f7;"></i>
                                </button>
                            </form>
                        }
                    </div>
                    <div id="desktopContent" style="display: none;">
                        <div class="d-block d-sm-flex align-items-baseline custom-heading">
                            <h1>PM ตรวจงาน @FormName </h1>
                            <div class="text-muted">
                                <h3 class="text-yellow"> &nbsp; @ProjectName ( Unit : @UnitCode )</h3>
                            </div>
                        </div>
                    </div>

                    <div id="ipadAirContent" style="display: none;">
                        <div class="d-block d-sm-flex align-items-baseline custom-heading">
                            <h3 class="mb-0 header-text">PM ตรวจงาน @FormName </h3>
                            <div class="text-muted">
                                <h5 class="text-yellow d-block d-sm-inline ms-sm-2 mb-0">@ProjectName ( Unit : @UnitCode )</h5>
                            </div>
                        </div>
                    </div>

                    <script>
                        // Function to check screen width and display appropriate content
                        function toggleContentBasedOnSize() {
                            const width = window.innerWidth;
                            const desktopContent = document.getElementById('desktopContent');
                            const ipadAirContent = document.getElementById('ipadAirContent');

                            // Reset displays
                            desktopContent.style.display = 'none';
                            ipadAirContent.style.display = 'none';

                            // Show based on size
                            if (width > 820) { // Devices larger than iPad Air
                                desktopContent.style.display = 'block';
                            } else if (width <= 820) { // Devices up to iPad Air size
                                ipadAirContent.style.display = 'block';
                            }
                        }

                        // Run on page load
                        toggleContentBasedOnSize();

                        // Recheck on window resize
                        window.addEventListener('resize', toggleContentBasedOnSize);
                    </script>


                    <div class="align-items-right">
                        <button class="status-dot bg-transparent">
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        @if (PCAll != 0)
        {
            <label id="statusLabel" class="form-label custom-label">มีการผ่านแบบมีเงื่อนไข!!!</label>
        }
        <div class="container mt-1 mb-2">
            <div class="row">
                @if (PCAll == 0)
                {
                    // Step configuration
                    string stepPE = "step-item";
                    string stepPMCheck = "step-item";
                    string stepPMApprove = "step-item";
                    string stepPMCheckText = "PM กำลังตรวจ";

                    // Icon configuration
                    string stepPEIcon = "fa-solid fa-clipboard-check";
                    string stepPMCheckIcon = "fa-solid fa-search";
                    string stepPMApproveIcon = "fa-solid fa-check-circle";

                    // Logic for step states
                    if (PM_Actiontype == "submit" && UnitFormStatusID < 4)
                    {
                        stepPE += " completed";
                        // stepPMCheck += " active";
                    }
                    else if (PM_Actiontype == "save" && UnitFormStatusID < 4)
                    {
                        stepPE += " completed";
                        stepPMCheck += " active";
                    }
                    else if (PM_Actiontype == "submit")
                    {
                        stepPE += " completed";

                        if (UnitFormStatusID == 4)
                        {
                            stepPMApprove += " completed";
                            stepPMCheck += " completed";
                        }
                        else if (UnitFormStatusID == 5)
                        {
                            stepPMCheckText = "PM ไม่อนุมัติผ่าน";
                            stepPMCheck += " danger";
                            stepPMCheckIcon = "fa-solid fa-times-circle";
                        }
                    }
                    <div class="col-md-6 mb-2">
                        <div class="card">
                            <div class="card-body">
                                <div class="stepper-container">
                                    <ul class="stepper">
                                        <li class="@stepPE">
                                            <div class="step-icon">
                                                <i class="@stepPEIcon"></i>
                                            </div>
                                            <span class="step-label">PE/SE ยืนยัน</span>
                                        </li>
                                        <li class="@stepPMCheck">
                                            <div class="step-icon">
                                                <i class="@stepPMCheckIcon"></i>
                                            </div>
                                            <span class="step-label">@stepPMCheckText</span>
                                        </li>
                                        <li class="@stepPMApprove">
                                            <div class="step-icon">
                                                <i class="@stepPMApproveIcon"></i>
                                            </div>
                                            <span class="step-label">PM อนุมัติผ่าน</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-2">
                        <div class="card" style="border: 2px solid #000066; padding: 16px; border-radius: 8px; background-color: #f8f9fa;">
                            <div class="card-stamp">
                                <div class="card-stamp-icon bg-yellow">
                                    <!-- Download SVG icon from http://tabler-icons.io/i/id -->
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-id"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 4m0 3a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v10a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3z" /><path d="M9 10m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M15 8l2 0" /><path d="M15 12l2 0" /><path d="M7 16l10 0" /></svg>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-12 col-sm-6">
                                        <h3 class="card-title">ข้อมูลรายละเอียด</h3>
                                        <p class="text-secondary mb-1">PE/SE ผู้ควบคุมงาน : @PEActionBy</p>
                                        <p class="text-secondary mb-1">เกรดงวดนี้ : @Grade</p>
                                        <p class="text-secondary mb-1">
                                            วันที่ส่งงาน : @if (PE_Actiontype == "submit")
                                            {
                                                @Actiondate
                                            }
                                        </p>
                                        @if (ViewBag.ConcatenatedQCNames != "")
                                        {
                                            <p class="text-secondary mb-1">
                                                การตรวจ :
                                                <a href="#!" class="badge bg-@ViewBag.qcStatusColore rounded-pill text-white"
                                                   onclick="goToSumaryQC('@ProjectID','@ProjectName', '@UnitID')">
                                                    <i class="fa-solid fa-magnifying-glass"></i> @ViewBag.ConcatenatedQCNames -
                                                    @ViewBag.QCStatusMessage
                                                </a>
                                            </p>
                                        }
                                        <p class="text-secondary mb-1">
                                            สร้างโดย : @CompanyName
                                        </p>
                                        <p class="text-secondary mb-1">
                                            ชื่อผู้รับเหมาเซ็น : @VenderName
                                        </p>
                                        <p class="text-secondary mb-1">
                                            @if (UnitFormStatusID == 4 && PM_Actiontype == "submit")
                                            {
                                                @if (ViewBag.FilePathPDF != null)
                                                {
                                                    <div class="col-12">
                                                        <a href="~/@ViewBag.FilePathPDF" target="_blank"
                                                           class="btn btn-secondary w-100">
                                                            ดูเอกสารตรวจ
                                                        </a>
                                                    </div>
                                                }
                                            }
                                            else if (UnitFormStatusID == 7 && PJM_Actiontype == "submit")
                                            {
                                                @if (ViewBag.FilePathPDF != null)
                                                {
                                                    <div class="col-12">
                                                        <a href="~/@ViewBag.FilePathPDF" target="_blank"
                                                           class="btn btn-secondary w-100">
                                                            ดูเอกสารตรวจ
                                                        </a>
                                                    </div>
                                                }
                                            }
                                            else if (UnitFormStatusID >= 9)
                                            {
                                                @if (ViewBag.FilePathPDF != null)
                                                {
                                                    <div class="col-12">
                                                        <a href="~/@ViewBag.FilePathPDF" target="_blank"
                                                           class="btn btn-secondary w-100">
                                                            ดูเอกสารตรวจ
                                                        </a>
                                                    </div>
                                                }
                                            }
                                        </p>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <h3 class="card-title">ลายเซ็นผู้รับเหมา</h3>
                                        @if (!string.IsNullOrEmpty(ViewBag.PathvenderSign as string))
                                        {
                                            <img src="~/@ViewBag.PathvenderSign" class="card-img-top custom-size" alt="Image in Card 2">
                                        }
                                        else
                                        {
                                            <label class="text-danger">ไม่มีรูปภาพ</label>
                                        }
                                    </div>

                                    <!-- Custom CSS -->
                                    <style>
                                        .custom-size {
                                            width: 288px;
                                            height: 160px;
                                            object-fit: cover; /* Ensures the image scales without distortion */
                                        }
                                    </style>

                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {

                    // Step configuration
                    string PCstepPE = "step-item";
                    string PCstepPM = "step-item";
                    string PCstepPJM = "step-item";
                    string PCstepLock = "step-item";
                    string PCstepUnLock = "step-item";
                    string PCstepPMText = "PM ตรวจ";
                    string PCstepPJMText = "PJM ตรวจ";

                    // Icon configuration
                    string PCstepPEIcon = "fa-solid fa-clipboard-check";
                    string PCstepPMIcon = "fa-solid fa-search";
                    string PCstepPJMIcon = "fa-solid fa-search";
                    string PCstepLockIcon = "fa-solid fa-lock";
                    string PCstepUnockIcon = "fa-solid fa-lock-open";
                    string PCstepFailIcon = "fa-solid fa-times-circle";

                    string UnlockColor = "secondary";

                    // Logic for step states
                    if (PJM_Actiontype == "submit" && UnitFormStatusID < 4)
                    {
                        PCstepPE += " completed";
                    }
                    else if (PM_Actiontype == "save" && UnitFormStatusID < 4)
                    {
                        PCstepPE += " completed";
                        PCstepPMText = "PM กำลังตรวจ";
                    }
                    else if (PM_Actiontype == "submit" && UnitFormStatusID < 7)
                    {
                        PCstepPE += " completed";

                        if (UnitFormStatusID == 6)
                        {
                            PCstepPMText = "PM อนุมัติผ่าน";
                            PCstepPM += " completed";
                            PCstepPMIcon = "fa-solid fa-clipboard-check";
                        }
                        else if (UnitFormStatusID == 5)
                        {
                            PCstepPMText = "PM ไม่อนุมัติผ่าน";
                            PCstepPM += " danger";
                            PCstepPMIcon = PCstepFailIcon;
                        }
                    }
                    else if (PJM_Actiontype == "save")
                    {
                        PCstepPE += " completed";
                        PCstepPM += " completed";
                        @* PCstepPJM += " completed"; *@
                        PCstepPJMText = "PJM กำลังตรวจ";
                        PCstepPMText = "PM อนุมัติผ่าน";
                        PCstepPMIcon = "fa-solid fa-clipboard-check";
                    }
                    else if (PJM_Actiontype == "submit" && UnitFormStatusID < 10)
                    {
                        PCstepPE += " completed";
                        PCstepPM += " completed";
                        PCstepPMText = "PM อนุมัติผ่าน";
                        PCstepPMIcon = "fa-solid fa-clipboard-check";
                        UnlockColor = "success";
                        if (UnitFormStatusID == 7)
                        {
                            PCstepPJMText = "PJM อนุมัติผ่าน";
                            PCstepPJM += " completed";
                            PCstepPJMIcon = "fa-solid fa-check-circle";
                        }
                        else if (UnitFormStatusID == 8)
                        {
                            PCstepPJMText = "PJM ไม่อนุมัติผ่าน";
                            PCstepPJM += " danger";
                            PCstepPJMIcon = PCstepFailIcon;
                        }
                    }
                    else if (UnitFormStatusID == 10)
                    {
                        UnlockColor = "success";
                        PCstepPJMText = "PJM อนุมัติผ่าน";
                        PCstepPMText = "PM อนุมัติผ่าน";
                        PCstepPMIcon = "fa-solid fa-clipboard-check";
                        PCstepPJMIcon = "fa-solid fa-check-circle";
                        PCstepPE += " completed";
                        PCstepPM += " completed";
                        PCstepPJM += " completed";
                        PCstepLock += " completed";
                    }
                    else if (UnitFormStatusID == 11)
                    {
                        UnlockColor = "success";
                        PCstepPJMText = "PJM อนุมัติผ่าน";
                        PCstepPMText = "PM อนุมัติผ่าน";
                        PCstepPMIcon = "fa-solid fa-clipboard-check";
                        PCstepPJMIcon = "fa-solid fa-check-circle";
                        PCstepPE += " completed";
                        PCstepPM += " completed";
                        PCstepPJM += " completed";
                        PCstepLock += " completed";
                        PCstepUnLock += " completed";
                    }

                    <div class="col-md-12 mb-2">
