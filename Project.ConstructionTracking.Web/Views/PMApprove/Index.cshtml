                                                        }
                                                        <p class="text-secondary mb-1">
                                                            สร้างโดย : @CompanyName
                                                        </p>
                                                        <p class="text-secondary mb-1">
                                                            ชื่อผู้รับเหมาเซ็น : @VenderName
                                                        </p>
                                                        <p class="text-secondary mb-1">
                                                            @if (UnitFormStatusID == 4 && PM_Actiontype == "submit")
                                                            {
                                                                @if (ViewBag.FilePathPDF != null)
                                                                {
                                                                    <div class="col-12">
                                                                        <a href="~/@ViewBag.FilePathPDF" target="_blank"
                                                                           class="btn btn-secondary w-100">
                                                                            ดูเอกสารตรวจ
                                                                        </a>
                                                                    </div>
                                                                }
                                                            }
                                                            else if (UnitFormStatusID == 7 && PJM_Actiontype == "submit")
                                                            {
                                                                @if (ViewBag.FilePathPDF != null)
                                                                {
                                                                    <div class="col-12">
                                                                        <a href="~/@ViewBag.FilePathPDF" target="_blank"
                                                                           class="btn btn-secondary w-100">
                                                                            ดูเอกสารตรวจ
                                                                        </a>
                                                                    </div>
                                                                }
                                                            }
                                                            else if (UnitFormStatusID >= 9)
                                                            {
                                                                @if (ViewBag.FilePathPDF != null)
                                                                {
                                                                    <div class="col-12">
                                                                        <a href="~/@ViewBag.FilePathPDF" target="_blank"
                                                                           class="btn btn-secondary w-100">
                                                                            ดูเอกสารตรวจ
                                                                        </a>
                                                                    </div>
                                                                }
                                                            }
                                                        </p>
