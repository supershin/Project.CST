@model Project.ConstructionTracking.Web.Models.SendMail.PMRequestModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        .email-container {
            max-width: 600px;
            margin: 20px auto;
            background-color: #ffffff;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
        }

        .email-header {
            background-color: #1d0e71;
            color: white;
            text-align: center;
            padding: 20px 10px;
        }

        .email-body {
            padding: 20px;
            color: #333;
            line-height: 1.6;
        }

        .email-body p {
            margin: 0 0 10px;
        }

        .email-footer {
            background-color: #f4f4f4;
            text-align: center;
            padding: 10px;
            font-size: 14px;
            color: #777;
        }

        .email-footer a {
            color: #4caf50;
            text-decoration: none;
        }

        .button {
            display: inline-block;
            background-color: #4caf50;
            color: white;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 5px;
            margin-top: 20px;
        }

        .status {
            background-color: #777;
            text-align: center;
            padding: 1px;
            border-radius: 5px;
            margin-bottom: 15px;
            color: white;
        }
        .statuspc {
            background-color: #288efa;
            text-align: center;
            padding: 1px;
            border-radius: 5px;
            margin-bottom: 15px;
            color: white;
        }

        .pcdetail {
            background-color: #288efa;
            padding: 1px;
            border-radius: 5px;
            margin-bottom: 15px;
            color: white;
        }

    </style>
</head>
<body>
    <div class="email-container">
        <div class="email-header">
            <h1>Construction Quality Tracking</h1>
        </div>
        <div class="email-body">
            <div class="statuspc">
                <h2>ขออนุมัติการผ่านแบบมีเงื่อนไข</h2>
            </div>
            <p>เรียน (PJM) @Model.PJMFullName</p>
            <p>ทางเราขอแจ้งให้ท่านทราบการขออนุมัติการผ่านมีเงื่อนไข โดยมีรายละเอียดดังนี้:</p>
            <ul>
                <li><strong>ชื่องวดงาน:</strong> @Model.FormName</li>
                <li><strong>PE ผู้ตรวจ:</strong> @Model.PEFullName</li>
                <li><strong>เวลาที่ตรวจ:</strong> @Model.ActionDatePE </li>
                <li><strong>PM ผู้ตรวจ:</strong> @Model.PMFullName </li>
                <li><strong>เวลาที่ตรวจ:</strong> @Model.ActionDatePM </li>
                <li><strong>โครงการ:</strong> @Model.ProjectName</li>
                <li><strong>เลขที่แปลง:</strong> @Model.UnitCode</li>
            </ul>
            <p>รายการงานที่ผ่านแบบมีเงื่อนมีดังนี้</p>
            @if (Model.ListPMRequesPassCondition.Count > 0)
            {
                <p>รายการงานที่ผ่านแบบมีเงื่อนมีดังนี้</p>
                foreach (var item in Model.ListPMRequesPassCondition)
                {
                    <div class="pcdetail">
                        <ul>
                            <li><strong>ชื่องาน:</strong> @item.FormGroupName</li>
                            <li><strong>เหตุผล (PE):</strong> @item.RemarkPassCoditionPE</li>
                            <li><strong>เหตุผล (PM):</strong> @item.RemarkPassCoditionPM</li>
                        </ul>
                    </div>
                }
            }
            <p>ขั้นตอนต่อไปท่านสามาถเข้าระบบ <a href="https://cqt.assetwise.co.th/cqt">Construction Quality Tracking</a> เพื่อตรวจสอบข้อมูลเพิ่มเติมหรือตรวจงวดงานในครั้งงวดถัดไป</strong></p>
        </div>
        <div class="email-footer">
            <p>Best Regard,</p>
            <p>Construction Quality Tracking</p>
        </div>
    </div>
</body>
</html>
